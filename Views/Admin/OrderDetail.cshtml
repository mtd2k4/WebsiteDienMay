@model WebsiteDienMay.Models.Order
@{
    ViewData["Title"] = "Chi tiết đơn hàng #" + Model.OrderCode;

    int stepIndex = Model.OrderStatus switch
    {
        "Chờ xác nhận" => 1,
        "Đã xác nhận" => 2,
        "Đang giao hàng" => 3,
        "Hoàn thành" => 4,
        _ => 0
    };
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 no-print">
    <div>
        <a asp-action="Orders" class="text-muted small text-decoration-none fw-semibold">
            <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách đơn hàng
        </a>
        <div class="d-flex align-items-center gap-2 mt-1">
            <h4 class="fw-extrabold m-0 text-dark">Đơn đặt hàng #@Model.OrderCode</h4>
            <span class="adm-badge @(Model.OrderStatus == "Hoàn thành" ? "adm-badge-success" : Model.OrderStatus == "Đã hủy" ? "adm-badge-danger" : "adm-badge-warning")">
                <span class="adm-badge-dot"></span>@Model.OrderStatus
            </span>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="PrintInvoice" asp-route-id="@Model.Id" target="_blank" class="btn btn-white bg-white border fw-semibold px-3 text-dark">
            <i class="bi bi-printer-fill text-primary me-1"></i>In hóa đơn & Phiếu xuất kho
        </a>
    </div>
</div>

<!-- Tiến trình xử lý đơn hàng trực quan -->
@if (Model.OrderStatus == "Đã hủy")
{
    <div class="adm-card border-danger bg-danger-subtle text-danger d-flex align-items-center gap-3 py-3">
        <i class="bi bi-x-octagon-fill fs-3"></i>
        <div>
            <div class="fw-bold">Đơn đặt hàng này đã bị hủy</div>
            <div class="small">Bạn vẫn có thể khôi phục trạng thái đơn hàng ở bảng điều khiển bên phải nếu khách hàng yêu cầu đặt lại.</div>
        </div>
    </div>
}
else
{
    <div class="adm-card py-3">
        <div class="adm-order-stepper">
            <div class="adm-order-step @(stepIndex > 1 ? "done" : stepIndex == 1 ? "current" : "")">
                <div class="adm-order-step-icon"><i class="bi bi-file-earmark-check"></i></div>
                <div class="adm-order-step-label">1. Chờ xác nhận</div>
            </div>
            <div class="adm-order-step @(stepIndex > 2 ? "done" : stepIndex == 2 ? "current" : "")">
                <div class="adm-order-step-icon"><i class="bi bi-box-seam"></i></div>
                <div class="adm-order-step-label">2. Đã xác nhận & Xuất kho</div>
            </div>
            <div class="adm-order-step @(stepIndex > 3 ? "done" : stepIndex == 3 ? "current" : "")">
                <div class="adm-order-step-icon"><i class="bi bi-truck"></i></div>
                <div class="adm-order-step-label">3. Đang giao & Lắp đặt</div>
            </div>
            <div class="adm-order-step @(stepIndex >= 4 ? "done" : "")">
                <div class="adm-order-step-icon"><i class="bi bi-patch-check-fill"></i></div>
                <div class="adm-order-step-label">4. Hoàn thành nghiệm thu</div>
            </div>
        </div>
    </div>
}

<div class="row g-4">
    <!-- Cột trái: Chi tiết sản phẩm & Thông tin giao nhận -->
    <div class="col-lg-8">
        <div class="adm-card">
            <div class="adm-card-header">
                <h6 class="adm-card-title">
                    <i class="bi bi-bag-check-fill text-primary"></i>
                    <span>Danh sách thiết bị đặt mua (@Model.OrderDetails.Sum(x => x.Quantity) sản phẩm)</span>
                </h6>
                <span class="text-muted small">Thời gian đặt: <strong>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</strong></span>
            </div>

            <div class="adm-table-wrap mb-3">
                <div class="table-responsive">
                    <table class="adm-table">
                        <thead>
                            <tr>
                                <th>Thiết bị điện tử</th>
                                <th class="text-center">Số lượng</th>
                                <th class="text-end">Đơn giá</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.OrderDetails)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="@d.ProductImage" alt="@d.ProductName" class="adm-thumb" />
                                            <div>
                                                <a asp-controller="Product" asp-action="Detail" asp-route-id="@d.ProductId" target="_blank" class="fw-bold text-dark text-decoration-none">
                                                    @d.ProductName
                                                </a>
                                                <div class="text-muted small">Mã SP: #@d.ProductId</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center fw-bold">x@(d.Quantity)</td>
                                    <td class="text-end">@d.UnitPrice.ToString("N0") đ</td>
                                    <td class="text-end fw-bold text-danger">@((d.UnitPrice * d.Quantity).ToString("N0")) đ</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="row justify-content-end">
                <div class="col-md-6">
                    <div class="p-3 rounded-3 bg-light border">
                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-muted">Tạm tính giá trị hàng:</span>
                            <span class="fw-semibold">@Model.SubTotal.ToString("N0") đ</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-muted">Mã ưu đãi @(string.IsNullOrEmpty(Model.CouponCode) ? "" : $"({Model.CouponCode})"):</span>
                            <span class="text-success fw-semibold">-@Model.DiscountAmount.ToString("N0") đ</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-muted">Phí vận chuyển & lắp đặt:</span>
                            <span class="text-success fw-semibold">Miễn phí</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center border-top pt-2 mt-2">
                            <span class="fw-bold text-dark">Tổng thanh toán:</span>
                            <span class="fw-extrabold fs-5 text-danger">@Model.TotalAmount.ToString("N0") đ</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="adm-card mb-0">
            <div class="adm-card-header">
                <h6 class="adm-card-title">
                    <i class="bi bi-person-lines-fill text-primary"></i>
                    <span>Thông tin người nhận & Địa chỉ lắp đặt</span>
                </h6>
            </div>

            <div class="row g-3 small">
                <div class="col-sm-6">
                    <div class="text-muted mb-1">Họ và tên khách hàng</div>
                    <div class="fw-bold text-dark fs-6">@Model.CustomerName</div>
                </div>
                <div class="col-sm-6">
                    <div class="text-muted mb-1">Số điện thoại liên hệ</div>
                    <div class="fw-bold text-primary fs-6">@Model.CustomerPhone</div>
                </div>
                <div class="col-sm-6">
                    <div class="text-muted mb-1">Email nhận hóa đơn</div>
                    <div class="fw-semibold text-dark">@(string.IsNullOrWhiteSpace(Model.CustomerEmail) ? "Chưa cung cấp" : Model.CustomerEmail)</div>
                </div>
                <div class="col-sm-6">
                    <div class="text-muted mb-1">Phương thức thanh toán</div>
                    <div class="fw-semibold text-dark">@Model.PaymentMethod — <span class="text-primary">@Model.PaymentStatus</span></div>
                </div>
                <div class="col-12">
                    <div class="text-muted mb-1">Địa chỉ giao hàng & lắp đặt</div>
                    <div class="p-2 px-3 rounded-3 bg-light border fw-semibold text-dark">
                        <i class="bi bi-geo-alt-fill text-danger me-1"></i>@Model.ShippingAddress
                    </div>
                </div>
                <div class="col-12">
                    <div class="text-muted mb-1">Ghi chú kỹ thuật từ khách hàng</div>
                    <div class="p-2 px-3 rounded-3 bg-warning-subtle border border-warning-subtle text-dark">
                        @(string.IsNullOrWhiteSpace(Model.Note) ? "Không có ghi chú đặc biệt." : Model.Note)
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Cột phải: Bảng điều khiển cập nhật trạng thái -->
    <div class="col-lg-4 no-print">
        <div class="adm-card position-sticky mb-0" style="top: 90px;">
            <div class="adm-card-header">
                <h6 class="adm-card-title">
                    <i class="bi bi-sliders2-vertical text-primary"></i>
                    <span>Điều phối & Cập nhật đơn</span>
                </h6>
            </div>

            <form asp-action="UpdateOrderStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />

                <div class="mb-3">
                    <label class="adm-form-label">Trạng thái xử lý đơn hàng</label>
                    <select name="orderStatus" class="form-select">
                        <option value="Chờ xác nhận" selected="@(Model.OrderStatus == "Chờ xác nhận")">Chờ xác nhận</option>
                        <option value="Đã xác nhận" selected="@(Model.OrderStatus == "Đã xác nhận")">Đã xác nhận & Chuẩn bị hàng</option>
                        <option value="Đang giao hàng" selected="@(Model.OrderStatus == "Đang giao hàng")">Đang giao hàng & Lắp đặt</option>
                        <option value="Hoàn thành" selected="@(Model.OrderStatus == "Hoàn thành")">Hoàn thành đơn hàng</option>
                        <option value="Đã hủy" selected="@(Model.OrderStatus == "Đã hủy")">Đã hủy đơn</option>
                    </select>
                </div>

                <div class="mb-4">
                    <label class="adm-form-label">Trạng thái thu tiền (@Model.PaymentMethod)</label>
                    <select name="paymentStatus" class="form-select">
                        <option value="Chưa thanh toán" selected="@(Model.PaymentStatus == "Chưa thanh toán")">Chưa thanh toán</option>
                        <option value="Thanh toán khi nhận hàng (COD)" selected="@(Model.PaymentStatus == "Thanh toán khi nhận hàng (COD)")">Thanh toán khi nhận hàng (COD)</option>
                        <option value="Chờ xác nhận chuyển khoản" selected="@(Model.PaymentStatus == "Chờ xác nhận chuyển khoản")">Chờ xác nhận chuyển khoản</option>
                        <option value="Đã thanh toán" selected="@(Model.PaymentStatus == "Đã thanh toán")">Đã thu tiền / Đã thanh toán</option>
                        <option value="Chờ duyệt hồ sơ trả góp 0%" selected="@(Model.PaymentStatus == "Chờ duyệt hồ sơ trả góp 0%")">Chờ duyệt hồ sơ trả góp 0%</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold rounded-3">
                    <i class="bi bi-check2-circle me-1"></i>Cập nhật trạng thái đơn
                </button>
            </form>
        </div>
    </div>
</div>
