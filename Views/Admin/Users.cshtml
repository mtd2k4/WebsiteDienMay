@model List<WebsiteDienMay.Models.User>
@{
    ViewData["Title"] = "Quản lý tài khoản người dùng";
    var adminCount = Model.Count(u => u.Role == "Admin");
    var customerCount = Model.Count(u => u.Role != "Admin");
    var activeUsers = Model.Count(u => u.IsActive);
}

<!-- Chỉ số tổng quan người dùng -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="adm-kpi-card py-3">
            <div class="adm-kpi-label">Tổng số tài khoản</div>
            <div class="fs-4 fw-extrabold text-dark mt-1">@Model.Count người dùng</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="adm-kpi-card py-3">
            <div class="adm-kpi-label">Khách hàng thành viên</div>
            <div class="fs-4 fw-extrabold text-primary mt-1">@customerCount tài khoản</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="adm-kpi-card py-3">
            <div class="adm-kpi-label">Quản trị viên / Đang hoạt động</div>
            <div class="fs-4 fw-extrabold text-success mt-1">@adminCount Admin • @activeUsers mở</div>
        </div>
    </div>
</div>

<div class="adm-card mb-0">
    <div class="adm-card-header">
        <div>
            <h5 class="adm-card-title">
                <i class="bi bi-people-fill text-primary"></i>
                <span>Danh sách tài khoản hệ thống</span>
            </h5>
            <div class="text-muted small mt-1">Phân quyền Quản trị viên (Admin) hoặc khóa/mở khóa tài khoản thành viên</div>
        </div>
        <div style="min-width: 280px;">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-light"><i class="bi bi-search text-muted"></i></span>
                <input type="text" id="userSearchInput" class="form-control" placeholder="Tìm nhanh tên, username, SĐT..." />
            </div>
        </div>
    </div>

    <div class="adm-table-wrap">
        <div class="table-responsive">
            <table class="adm-table" id="userTable">
                <thead>
                    <tr>
                        <th>Người dùng</th>
                        <th>Thông tin liên hệ</th>
                        <th>Địa chỉ mặc định</th>
                        <th class="text-center">Đơn đã đặt</th>
                        <th class="text-center">Vai trò</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        var initial = !string.IsNullOrWhiteSpace(u.FullName) ? u.FullName.Trim().Substring(0, 1).ToUpper() : "U";
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <span class="adm-avatar" style="@(u.Role == "Admin" ? "background: linear-gradient(135deg,#dc2626,#b91c1c);" : "")">
                                        @initial
                                    </span>
                                    <div>
                                        <div class="fw-bold text-dark">@u.FullName</div>
                                        <div class="text-primary small fw-semibold">@@@u.Username</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="small fw-medium">@u.Email</div>
                                <div class="text-muted small"><i class="bi bi-telephone me-1"></i>@u.Phone</div>
                            </td>
                            <td class="small text-muted" style="max-width: 240px;">@u.Address</td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark border">@(u.Orders?.Count ?? 0) đơn</span>
                            </td>
                            <td class="text-center">
                                @if (u.Role == "Admin")
                                {
                                    <span class="adm-badge adm-badge-danger">
                                        <i class="bi bi-shield-lock-fill"></i>Admin
                                    </span>
                                }
                                else
                                {
                                    <span class="adm-badge adm-badge-info">Khách hàng</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (u.IsActive)
                                {
                                    <span class="adm-badge adm-badge-success">
                                        <span class="adm-badge-dot"></span>Hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span class="adm-badge adm-badge-neutral">
                                        <span class="adm-badge-dot"></span>Đã khóa
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex align-items-center gap-1">
                                    <form asp-action="ToggleUserRole" method="post"
                                          class="swal-confirm-form d-inline"
                                          data-swal-title="Thay đổi phân quyền?"
                                          data-swal-text="Chuyển đổi quyền truy cập của tài khoản '@u.Username'?"
                                          data-swal-icon="question"
                                          data-swal-color="#2563eb"
                                          data-swal-confirm="Xác nhận đổi quyền">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@u.Id" />
                                        <button type="submit" class="btn btn-light border btn-sm fw-semibold" title="Đổi vai trò Admin / Customer">
                                            <i class="bi bi-person-gear text-primary me-1"></i>Đổi quyền
                                        </button>
                                    </form>

                                    @if (u.Username != "admin")
                                    {
                                        <form asp-action="ToggleUserStatus" method="post"
                                              class="swal-confirm-form d-inline"
                                              data-swal-title="@(u.IsActive ? "Khóa tài khoản này?" : "Mở khóa tài khoản?")"
                                              data-swal-text="Bạn có chắc chắn muốn @(u.IsActive ? "khóa" : "mở khóa") tài khoản '@u.Username'?"
                                              data-swal-confirm="Đồng ý">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@u.Id" />
                                            <button type="submit" class="adm-icon-btn @(u.IsActive ? "danger" : "")" title="@(u.IsActive ? "Khóa tài khoản" : "Mở khóa tài khoản")">
                                                <i class="bi @(u.IsActive ? "bi-lock" : "bi-unlock text-success")"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("userSearchInput");
            const rows = document.querySelectorAll("#userTable tbody tr");
            if (searchInput) {
                searchInput.addEventListener("input", function () {
                    const kw = this.value.toLowerCase().trim();
                    rows.forEach(function (row) {
                        row.style.display = row.innerText.toLowerCase().includes(kw) ? "" : "none";
                    });
                });
            }
        });
    </script>
}
