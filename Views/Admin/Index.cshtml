@model WebsiteDienMay.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Tổng quan hệ thống";
    var otherOrders = Math.Max(0, Model.TotalOrders - Model.CompletedOrders - Model.PendingOrders);
    var topLabels = Model.TopSellingProducts.Select(p => p.Name.Length > 26 ? p.Name.Substring(0, 26) + "..." : p.Name).ToList();
    var topSoldData = Model.TopSellingProducts.Select(p => p.SoldCount).ToList();
}

<!-- Banner điều hành nhanh -->
<div class="adm-card border-0 text-white mb-4" style="background: linear-gradient(125deg, #0f172a 0%, #1e3a8a 55%, #2563eb 100%);">
    <div class="row align-items-center g-3">
        <div class="col-lg-8">
            <span class="badge bg-warning text-dark fw-bold px-3 py-1 rounded-pill mb-2">
                <i class="bi bi-bar-chart-line-fill me-1"></i>TRUNG TÂM ĐIỀU HÀNH KINH DOANH
            </span>
            <h4 class="fw-extrabold mb-1">Bảng điều khiển Quản trị Điện Máy Xanh</h4>
            <p class="mb-0 opacity-75 small">
                Theo dõi doanh thu thời gian thực, xử lý đơn đặt hàng trực tuyến và kiểm soát tồn kho thiết bị điện tử trên toàn hệ thống.
            </p>
        </div>
        <div class="col-lg-4 d-flex flex-wrap justify-content-lg-end gap-2">
            <a asp-action="RevenueReport" class="btn btn-outline-light btn-sm fw-bold px-3 py-2 rounded-3">
                <i class="bi bi-file-earmark-pdf me-1"></i>Báo cáo PDF
            </a>
            <a asp-action="Orders" asp-route-status="Chờ xác nhận" class="btn btn-warning btn-sm fw-bold px-3 py-2 rounded-3 text-dark">
                <i class="bi bi-bell-fill me-1"></i>Đơn chờ duyệt (@Model.PendingOrders)
            </a>
            <a asp-action="CreateProduct" class="btn btn-light btn-sm fw-bold px-3 py-2 rounded-3 text-primary">
                <i class="bi bi-plus-circle-fill me-1"></i>Thêm SP
            </a>
        </div>
    </div>
</div>

<!-- 4 Thẻ KPI Chiến lược -->
<div class="row g-3 mb-4">
    <div class="col-xl-3 col-sm-6">
        <div class="adm-kpi-card">
            <div class="d-flex align-items-start justify-content-between gap-2">
                <div>
                    <div class="adm-kpi-label">Tổng doanh thu thực tế</div>
                    <div class="adm-kpi-value text-danger">@Model.TotalRevenue.ToString("N0") đ</div>
                    <div class="adm-kpi-sub">
                        <a asp-action="RevenueReport" class="text-decoration-none fw-semibold">
                            <i class="bi bi-graph-up-arrow text-primary me-1"></i>Xem báo cáo & Xuất PDF <i class="bi bi-chevron-right"></i>
                        </a>
                    </div>
                </div>
                <div class="adm-kpi-icon" style="background: #fef2f2; color: #dc2626;">
                    <i class="bi bi-cash-coin"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="adm-kpi-card">
            <div class="d-flex align-items-start justify-content-between gap-2">
                <div>
                    <div class="adm-kpi-label">Đơn hàng chờ xử lý</div>
                    <div class="adm-kpi-value text-warning">@Model.PendingOrders đơn</div>
                    <div class="adm-kpi-sub">
                        <i class="bi bi-check2-circle text-success me-1"></i>Đã hoàn thành: <strong>@Model.CompletedOrders</strong> đơn
                    </div>
                </div>
                <div class="adm-kpi-icon" style="background: #fffbeb; color: #d97706;">
                    <i class="bi bi-hourglass-split"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="adm-kpi-card">
            <div class="d-flex align-items-start justify-content-between gap-2">
                <div>
                    <div class="adm-kpi-label">Danh mục & Sản phẩm</div>
                    <div class="adm-kpi-value text-primary">@Model.TotalProducts SP</div>
                    <div class="adm-kpi-sub">
                        <i class="bi bi-layers text-info me-1"></i><strong>@Model.TotalCategories</strong> ngành hàng • <strong>@Model.TotalBrands</strong> hãng
                    </div>
                </div>
                <div class="adm-kpi-icon" style="background: #eff6ff; color: #2563eb;">
                    <i class="bi bi-box-seam"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="adm-kpi-card">
            <div class="d-flex align-items-start justify-content-between gap-2">
                <div>
                    <div class="adm-kpi-label">Tài khoản hệ thống</div>
                    <div class="adm-kpi-value text-success">@Model.TotalUsers</div>
                    <div class="adm-kpi-sub">
                        <i class="bi bi-shield-check text-success me-1"></i>Khách hàng & Quản trị viên
                    </div>
                </div>
                <div class="adm-kpi-icon" style="background: #ecfdf5; color: #059669;">
                    <i class="bi bi-people"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Biểu đồ Trực quan (Chart.js) -->
<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="adm-card h-100 mb-0">
            <div class="adm-card-header">
                <h6 class="adm-card-title">
                    <i class="bi bi-bar-chart-steps text-primary"></i>
                    <span>Sản lượng tiêu thụ Top 6 sản phẩm chủ lực</span>
                </h6>
                <a asp-action="Products" class="btn btn-light border btn-sm fw-semibold text-secondary">
                    Chi tiết kho hàng <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
            <div style="height: 270px;">
                <canvas id="topProductsChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="adm-card h-100 mb-0">
            <div class="adm-card-header">
                <h6 class="adm-card-title">
                    <i class="bi bi-pie-chart-fill text-primary"></i>
                    <span>Cơ cấu trạng thái đơn hàng</span>
                </h6>
            </div>
            <div style="height: 210px;" class="d-flex align-items-center justify-content-center">
                <canvas id="orderStatusChart"></canvas>
            </div>
            <div class="row g-2 mt-3 pt-2 border-top text-center small">
                <div class="col-4">
                    <div class="text-muted">Hoàn thành</div>
                    <div class="fw-bold text-success">@Model.CompletedOrders</div>
                </div>
                <div class="col-4 border-start border-end">
                    <div class="text-muted">Chờ duyệt</div>
                    <div class="fw-bold text-warning">@Model.PendingOrders</div>
                </div>
                <div class="col-4">
                    <div class="text-muted">Khác</div>
                    <div class="fw-bold text-secondary">@otherOrders</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Đơn đặt hàng mới nhất & Sản phẩm tiêu điểm -->
<div class="row g-4">
    <div class="col-lg-7">
        <div class="adm-card h-100 mb-0">
            <div class="adm-card-header">
                <h6 class="adm-card-title">
                    <i class="bi bi-clock-history text-primary"></i>
                    <span>Đơn đặt hàng mới nhất</span>
                </h6>
                <a asp-action="Orders" class="btn btn-outline-primary btn-sm fw-semibold rounded-3">
                    Quản lý tất cả đơn
                </a>
            </div>

            <div class="adm-table-wrap">
                <div class="table-responsive">
                    <table class="adm-table">
                        <thead>
                            <tr>
                                <th>Mã đơn</th>
                                <th>Khách hàng</th>
                                <th class="text-end">Tổng tiền</th>
                                <th class="text-center">Trạng thái</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var o in Model.RecentOrders)
                            {
                                var badgeClass = o.OrderStatus switch
                                {
                                    "Hoàn thành" => "adm-badge-success",
                                    "Đã hủy" => "adm-badge-danger",
                                    "Đang giao hàng" => "adm-badge-info",
                                    _ => "adm-badge-warning"
                                };
                                <tr>
                                    <td>
                                        <a asp-action="OrderDetail" asp-route-id="@o.Id" class="fw-bold text-primary text-decoration-none">
                                            #@o.OrderCode
                                        </a>
                                        <div class="text-muted" style="font-size: 11.5px;">@o.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">@o.CustomerName</div>
                                        <div class="text-muted" style="font-size: 12px;"><i class="bi bi-telephone me-1"></i>@o.CustomerPhone</div>
                                    </td>
                                    <td class="text-end fw-bold text-danger">@o.TotalAmount.ToString("N0") đ</td>
                                    <td class="text-center">
                                        <span class="adm-badge @badgeClass">
                                            <span class="adm-badge-dot"></span>
                                            @o.OrderStatus
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="OrderDetail" asp-route-id="@o.Id" class="adm-icon-btn" title="Xử lý đơn hàng">
                                            <i class="bi bi-arrow-right-short fs-5"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Tab Top Bán chạy & Cảnh báo tồn kho thấp -->
    <div class="col-lg-5">
        <div class="adm-card h-100 mb-0">
            <div class="d-flex align-items-center justify-content-between border-bottom pb-3 mb-3">
                <ul class="nav nav-pills gap-2" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="adm-filter-pill active" data-bs-toggle="pill" data-bs-target="#tabTopSelling" type="button" role="tab">
                            <i class="bi bi-fire text-danger"></i>Top bán chạy
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="adm-filter-pill" data-bs-toggle="pill" data-bs-target="#tabLowStock" type="button" role="tab">
                            <i class="bi bi-exclamation-triangle text-warning"></i>Sắp hết hàng
                        </button>
                    </li>
                </ul>
            </div>

            <div class="tab-content">
                <!-- Tab 1: Top Bán Chạy -->
                <div class="tab-pane fade show active" id="tabTopSelling" role="tabpanel">
                    <div class="d-flex flex-column gap-3">
                        @foreach (var p in Model.TopSellingProducts)
                        {
                            <div class="d-flex align-items-center justify-content-between gap-3 p-2 rounded-3 border bg-light bg-opacity-50">
                                <div class="d-flex align-items-center gap-3 min-w-0">
                                    <img src="@p.ImageUrl" alt="@p.Name" class="adm-thumb" />
                                    <div class="min-w-0">
                                        <a asp-action="EditProduct" asp-route-id="@p.Id" class="fw-semibold text-dark text-decoration-none d-block text-truncate" style="max-width: 230px;" title="@p.Name">
                                            @p.Name
                                        </a>
                                        <div class="small text-muted">
                                            Giá: <strong class="text-danger">@p.Price.ToString("N0") đ</strong> • Kho: <strong>@p.StockQuantity</strong>
                                        </div>
                                    </div>
                                </div>
                                <span class="adm-badge adm-badge-info flex-shrink-0">Đã bán @p.SoldCount</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Tab 2: Cảnh báo tồn kho thấp -->
                <div class="tab-pane fade" id="tabLowStock" role="tabpanel">
                    <div class="d-flex flex-column gap-3">
                        @foreach (var p in Model.LowStockProducts)
                        {
                            <div class="d-flex align-items-center justify-content-between gap-3 p-2 rounded-3 border">
                                <div class="d-flex align-items-center gap-3 min-w-0">
                                    <img src="@p.ImageUrl" alt="@p.Name" class="adm-thumb" />
                                    <div class="min-w-0">
                                        <a asp-action="EditProduct" asp-route-id="@p.Id" class="fw-semibold text-dark text-decoration-none d-block text-truncate" style="max-width: 220px;">
                                            @p.Name
                                        </a>
                                        <div class="small text-muted">Mã: <strong>@p.Code</strong> • @p.Brand?.Name</div>
                                    </div>
                                </div>
                                <div class="text-end flex-shrink-0">
                                    <span class="adm-badge @(p.StockQuantity <= 10 ? "adm-badge-danger" : "adm-badge-warning")">
                                        Còn @p.StockQuantity
                                    </span>
                                    <div class="mt-1">
                                        <a asp-action="Warehouse" asp-route-productId="@p.Id" class="small fw-semibold text-primary text-decoration-none">Nhập kho</a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const topCtx = document.getElementById("topProductsChart");
            if (topCtx) {
                new Chart(topCtx, {
                    type: "bar",
                    data: {
                        labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(topLabels)),
                        datasets: [{
                            label: "Số lượng đã bán",
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(topSoldData)),
                            backgroundColor: "rgba(37, 99, 235, 0.85)",
                            hoverBackgroundColor: "#1d4ed8",
                            borderRadius: 8,
                            maxBarThickness: 38
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                grid: { color: "#f1f5f9" }
                            },
                            x: {
                                grid: { display: false },
                                ticks: { font: { size: 11 } }
                            }
                        }
                    }
                });
            }

            const statusCtx = document.getElementById("orderStatusChart");
            if (statusCtx) {
                new Chart(statusCtx, {
                    type: "doughnut",
                    data: {
                        labels: ["Hoàn thành", "Chờ xác nhận", "Đang giao / Khác"],
                        datasets: [{
                            data: [@Model.CompletedOrders, @Model.PendingOrders, @otherOrders],
                            backgroundColor: ["#10b981", "#f59e0b", "#3b82f6"],
                            borderWidth: 0
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: "68%",
                        plugins: {
                            legend: {
                                position: "bottom",
                                labels: { boxWidth: 12, padding: 14, font: { size: 12 } }
                            }
                        }
                    }
                });
            }
        });
    </script>
}
