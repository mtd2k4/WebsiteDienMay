@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Truy cập bị từ chối";
}

<div class="text-center py-3">
    <div class="mb-3">
        <span class="d-inline-flex align-items-center justify-content-center bg-danger-subtle text-danger rounded-circle" style="width: 72px; height: 72px;">
            <i class="bi bi-shield-lock-fill fs-1"></i>
        </span>
    </div>
    <h4 class="fw-black text-danger mb-2">TRUY CẬP BỊ TỪ CHỐI</h4>
    <p class="text-muted mb-4">
        Khu vực <strong>Quản trị hệ thống (Admin CMS)</strong> chỉ dành riêng cho tài khoản Quản trị viên. Tài khoản khách hàng không có quyền truy cập vào trang này.
    </p>
    <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 fw-bold">
            <i class="bi bi-house-door-fill me-1"></i>Về Trang chủ mua sắm
        </a>
        <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger px-4 fw-semibold">
            <i class="bi bi-box-arrow-right me-1"></i>Đăng xuất để đổi tài khoản Admin
        </a>
    </div>
</div>

