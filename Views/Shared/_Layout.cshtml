@using Microsoft.AspNetCore.Http
@using WebsiteDienMay.Helpers
@using WebsiteDienMay.Models
@inject IHttpContextAccessor HttpContextAccessor
@{
    var session = HttpContextAccessor.HttpContext?.Session;
    var userId = session?.GetInt32("USER_ID");
    var userFullName = session?.GetString("USER_FULLNAME");
    var userRole = session?.GetString("USER_ROLE");
    var displayUserName = (userFullName ?? "Tài khoản")
        .Replace("(Quản trị viên)", "", StringComparison.OrdinalIgnoreCase)
        .Trim();
    var cartItems = session?.GetObjectFromJson<List<CartItemViewModel>>("CART_SESSION") ?? new List<CartItemViewModel>();
    var cartCount = cartItems.Sum(x => x.Quantity);
    var currentCategoryId = Context.Request.Query["categoryId"].ToString();
    var currentSort = Context.Request.Query["sort"].ToString();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Siêu thị Điện Máy Xanh</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Main Sticky Header -->
    <header class="dmx-header">
        <div class="container">
            <div class="dmx-header-main">
                <!-- Left: Brand Logo & Mega Category Dropdown -->
                <div class="dmx-header-left">
                    <a asp-controller="Home" asp-action="Index" class="dmx-logo-box">
                        <span>ĐIỆN MÁY XANH</span>
                        <span class="dmx-logo-sub">.COM</span>
                    </a>

                    <div class="dropdown">
                        <button class="dmx-cate-dropdown-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-grid-fill"></i>
                            <span>Danh mục</span>
                            <i class="bi bi-chevron-down dmx-caret"></i>
                        </button>
                        <div class="dropdown-menu dmx-dropdown-menu">
                            <div class="d-flex align-items-center justify-content-between border-bottom pb-2 mb-2 px-1">
                                <span class="fw-bold text-uppercase small text-primary">Danh mục ngành hàng điện máy</span>
                                <a asp-controller="Product" asp-action="Index" class="small fw-semibold text-primary">
                                    Xem tất cả <i class="bi bi-chevron-right"></i>
                                </a>
                            </div>
                            <div class="dmx-dropdown-grid">
                                <a asp-controller="Product" asp-action="Index" asp-route-categoryId="1" class="dmx-dropdown-item">
                                    <img src="https://cdnv2.tgdd.vn/pim/cdn/images/202610/Tivi110032.png" alt="Tivi" />
                                    <div>
                                        <div class="fw-bold small">Tivi</div>
                                        <div class="text-muted" style="font-size: 11.5px;">QLED, OLED, Mini LED 4K</div>
                                    </div>
                                </a>
                                <a asp-controller="Product" asp-action="Index" asp-route-categoryId="2" class="dmx-dropdown-item">
                                    <img src="https://cdnv2.tgdd.vn/pim/cdn/images/202610/TL105955.png" alt="Tủ lạnh" />
                                    <div>
                                        <div class="fw-bold small">Tủ lạnh</div>
                                        <div class="text-muted" style="font-size: 11.5px;">Side by Side, Multi Door</div>
                                    </div>
                                </a>
                                <a asp-controller="Product" asp-action="Index" asp-route-categoryId="3" class="dmx-dropdown-item">
                                    <img src="https://cdnv2.tgdd.vn/pim/cdn/images/202610/MG105936.png" alt="Máy giặt" />
                                    <div>
                                        <div class="fw-bold small">Máy giặt</div>
                                        <div class="text-muted" style="font-size: 11.5px;">Cửa ngang, Cửa trên Inverter</div>
                                    </div>
                                </a>
                                <a asp-controller="Product" asp-action="Index" asp-route-categoryId="4" class="dmx-dropdown-item">
                                    <img src="https://cdn.tgdd.vn/2026/11/timerseo/1751098000005-may-lanh-tron-20261105-600x600.png" alt="Máy lạnh" />
                                    <div>
                                        <div class="fw-bold small">Máy lạnh - Điều hòa</div>
                                        <div class="text-muted" style="font-size: 11.5px;">Inverter tiết kiệm điện</div>
                                    </div>
                                </a>
                                <a asp-controller="Product" asp-action="Index" asp-route-categoryId="5" class="dmx-dropdown-item">
                                    <img src="https://cdn.tgdd.vn/Products/Images/42/370982/iphone-18-pro-max-do-thumb.jpg" alt="Điện thoại" />
                                    <div>
                                        <div class="fw-bold small">Điện thoại</div>
                                        <div class="text-muted" style="font-size: 11.5px;">iPhone, Samsung, OPPO, Xiaomi</div>
                                    </div>
                                </a>
                                <a asp-controller="Product" asp-action="Index" asp-route-categoryId="6" class="dmx-dropdown-item">
                                    <img src="https://cdn.tgdd.vn/2026/11/timerseo/0220042003457-laptop-tron-20261104-600x600.png" alt="Laptop" />
                                    <div>
                                        <div class="fw-bold small">Laptop</div>
                                        <div class="text-muted" style="font-size: 11.5px;">Asus, Dell, HP, Lenovo</div>
                                    </div>
                                </a>
                                <a asp-controller="Product" asp-action="Index" asp-route-categoryId="7" class="dmx-dropdown-item">
                                    <img src="https://cdnv2.tgdd.vn/pim/cdn/images/202610/GD110019.png" alt="Gia dụng" />
                                    <div>
                                        <div class="fw-bold small">Gia dụng nhà bếp</div>
                                        <div class="text-muted" style="font-size: 11.5px;">Nồi chiên, Máy rửa chén</div>
                                    </div>
                                </a>
                                <a asp-controller="Product" asp-action="Index" asp-route-categoryId="8" class="dmx-dropdown-item">
                                    <img src="https://cdn.tgdd.vn/2026/11/timerseo/325006.jpg" alt="Máy lọc nước" />
                                    <div>
                                        <div class="fw-bold small">Máy lọc nước</div>
                                        <div class="text-muted" style="font-size: 11.5px;">RO nóng lạnh, Ion kiềm</div>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Center: Full-Width Flexible Search Bar with Live Autocomplete -->
                <form asp-controller="Product" asp-action="Index" method="get" class="dmx-search-form" id="mainSearchForm" autocomplete="off">
                    <input type="text" name="keyword" id="liveSearchInput" value="@Context.Request.Query["keyword"]" class="dmx-search-input" placeholder="Bạn tìm gì hôm nay? Tivi, Tủ lạnh, Máy giặt, iPhone..." />
                    <button type="submit" class="dmx-search-btn" title="Tìm kiếm">
                        <i class="bi bi-search"></i>
                    </button>
                    <div id="liveSearchDropdown" class="dmx-search-dropdown d-none"></div>
                </form>

                <!-- Right: Compact Action Buttons -->
                <div class="dmx-header-actions">
                    <a asp-controller="Cart" asp-action="TrackOrder" class="dmx-header-action">
                        <i class="bi bi-receipt-cutoff"></i>
                        <span>Đơn hàng</span>
                    </a>

                    <a asp-controller="Cart" asp-action="Index" class="dmx-header-action">
                        <i class="bi bi-cart3"></i>
                        <span>Giỏ hàng</span>
                        <span class="dmx-cart-badge">@cartCount</span>
                    </a>

                    @if (userId.HasValue)
                    {
                        @if (userRole == "Admin")
                        {
                            <a asp-controller="Admin" asp-action="Index" class="dmx-header-action admin-btn" title="Hệ thống Quản trị">
                                <i class="bi bi-speedometer2"></i>
                                <span>Quản trị</span>
                            </a>
                        }

                        <div class="dropdown">
                            <button class="dmx-header-action dmx-user-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle"></i>
                                <span class="dmx-user-label">@displayUserName</span>
                                <i class="bi bi-chevron-down dmx-caret"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end dmx-user-menu">
                                <li class="px-3 py-2 border-bottom">
                                    <div class="fw-bold text-dark small">@displayUserName</div>
                                    <span class="badge @(userRole == "Admin" ? "bg-warning text-dark" : "bg-primary-subtle text-primary") mt-1" style="font-size: 11px;">
                                        @(userRole == "Admin" ? "Quản trị viên" : "Khách hàng thành viên")
                                    </span>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2 small fw-medium" asp-controller="Account" asp-action="Profile">
                                        <i class="bi bi-person-vcard text-primary me-2"></i>Thông tin tài khoản
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2 small fw-medium" asp-controller="Cart" asp-action="TrackOrder">
                                        <i class="bi bi-bag-check text-primary me-2"></i>Lịch sử đơn hàng
                                    </a>
                                </li>
                                @if (userRole == "Admin")
                                {
                                    <li>
                                        <a class="dropdown-item py-2 small fw-semibold text-primary" asp-controller="Admin" asp-action="Index">
                                            <i class="bi bi-speedometer2 me-2"></i>Bảng điều khiển Admin
                                        </a>
                                    </li>
                                }
                                <li><hr class="dropdown-divider my-1" /></li>
                                <li>
                                    <a class="dropdown-item py-2 small fw-semibold text-danger swal-confirm-link"
                                       asp-controller="Account" asp-action="Logout"
                                       data-swal-title="Đăng xuất tài khoản?"
                                       data-swal-text="Bạn có chắc chắn muốn đăng xuất khỏi hệ thống Điện Máy Xanh?">
                                        <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="dmx-header-action">
                            <i class="bi bi-person-circle"></i>
                            <span>Đăng nhập</span>
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- Horizontal Category Navigation Bar -->
        <nav class="dmx-navbar">
            <div class="container">
                <ul class="dmx-nav-list">
                    <li class="dmx-nav-item">
                        <a asp-controller="Product" asp-action="Index" asp-route-categoryId="1" class="@(currentCategoryId == "1" ? "active" : "")">
                            <i class="bi bi-tv"></i>
                            <span>Tivi</span>
                        </a>
                    </li>
                    <li class="dmx-nav-item">
                        <a asp-controller="Product" asp-action="Index" asp-route-categoryId="2" class="@(currentCategoryId == "2" ? "active" : "")">
                            <i class="bi bi-snow2"></i>
                            <span>Tủ lạnh</span>
                        </a>
                    </li>
                    <li class="dmx-nav-item">
                        <a asp-controller="Product" asp-action="Index" asp-route-categoryId="3" class="@(currentCategoryId == "3" ? "active" : "")">
                            <i class="bi bi-water"></i>
                            <span>Máy giặt</span>
                        </a>
                    </li>
                    <li class="dmx-nav-item">
                        <a asp-controller="Product" asp-action="Index" asp-route-categoryId="4" class="@(currentCategoryId == "4" ? "active" : "")">
                            <i class="bi bi-wind"></i>
                            <span>Máy lạnh</span>
                        </a>
                    </li>
                    <li class="dmx-nav-item">
                        <a asp-controller="Product" asp-action="Index" asp-route-categoryId="5" class="@(currentCategoryId == "5" ? "active" : "")">
                            <i class="bi bi-phone"></i>
                            <span>Điện thoại</span>
                        </a>
                    </li>
                    <li class="dmx-nav-item">
                        <a asp-controller="Product" asp-action="Index" asp-route-categoryId="6" class="@(currentCategoryId == "6" ? "active" : "")">
                            <i class="bi bi-laptop"></i>
                            <span>Laptop</span>
                        </a>
                    </li>
                    <li class="dmx-nav-item">
                        <a asp-controller="Product" asp-action="Index" asp-route-categoryId="7" class="@(currentCategoryId == "7" ? "active" : "")">
                            <i class="bi bi-house-heart"></i>
                            <span>Gia dụng</span>
                        </a>
                    </li>
                    <li class="dmx-nav-item">
                        <a asp-controller="Product" asp-action="Index" asp-route-categoryId="8" class="@(currentCategoryId == "8" ? "active" : "")">
                            <i class="bi bi-droplet-half"></i>
                            <span>Máy lọc nước</span>
                        </a>
                    </li>
                    <li class="dmx-nav-item">
                        <a asp-controller="Product" asp-action="Index" asp-route-sort="discount" class="@(currentSort == "discount" && string.IsNullOrEmpty(currentCategoryId) ? "active" : "")">
                            <i class="bi bi-lightning-charge-fill text-warning"></i>
                            <span>Khuyến mãi Giờ vàng</span>
                        </a>
                    </li>
                    <li class="dmx-nav-item">
                        <a asp-controller="Home" asp-action="WarrantyPolicy" class="@(currentController == "Home" && currentAction == "WarrantyPolicy" ? "active" : "")">
                            <i class="bi bi-shield-check"></i>
                            <span>Bảo hành & Đổi trả</span>
                        </a>
                    </li>
                </ul>
            </div>
        </nav>
    </header>

    <!-- Main Content -->
    <main class="py-3">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="dmx-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-3 col-md-6">
                    <h6>Tổng đài hỗ trợ miễn phí</h6>
                    <ul class="dmx-footer-links">
                        <li>Gọi mua hàng: <strong class="text-primary">1900 232 461</strong> (8:00 - 21:30)</li>
                        <li>Khiếu nại, góp ý: <strong class="text-primary">1800 1063</strong> (8:00 - 21:30)</li>
                        <li>Bảo hành kỹ thuật: <strong class="text-primary">1900 232 465</strong> (8:00 - 21:00)</li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6>Thông tin và chính sách</h6>
                    <ul class="dmx-footer-links">
                        <li><a asp-controller="Home" asp-action="About">Giới thiệu hệ thống Siêu thị Điện Máy Xanh</a></li>
                        <li><a asp-controller="Home" asp-action="WarrantyPolicy">Chính sách bảo hành & Đổi trả 30 ngày</a></li>
                        <li><a asp-controller="Cart" asp-action="TrackOrder">Tra cứu thông tin đơn đặt hàng</a></li>
                        <li><a asp-controller="Product" asp-action="Index">Chính sách trả góp 0% lãi suất</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6>Danh mục thiết bị điện tử</h6>
                    <ul class="dmx-footer-links">
                        <li><a asp-controller="Product" asp-action="Index" asp-route-categoryId="1">Smart Tivi QLED, OLED, Mini LED 4K</a></li>
                        <li><a asp-controller="Product" asp-action="Index" asp-route-categoryId="2">Tủ lạnh Side by Side, Multi Door Inverter</a></li>
                        <li><a asp-controller="Product" asp-action="Index" asp-route-categoryId="3">Máy giặt cửa ngang, Máy lạnh Inverter</a></li>
                        <li><a asp-controller="Product" asp-action="Index" asp-route-categoryId="5">Điện thoại iPhone, Laptop chính hãng</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6>Dịch vụ & Hỗ trợ thanh toán</h6>
                    <div class="p-3 rounded-3 bg-light border small">
                        <div class="fw-bold text-primary mb-2">CAM KẾT CHÍNH HÃNG 100%</div>
                        <div class="mb-1"><i class="bi bi-check2-circle text-success me-1"></i>Giao hàng & lắp đặt miễn phí tận nơi</div>
                        <div class="mb-1"><i class="bi bi-check2-circle text-success me-1"></i>Thanh toán COD, VietQR 24/7</div>
                        <div><i class="bi bi-check2-circle text-success me-1"></i>Hỗ trợ trả góp 0% lãi suất toàn quốc</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="dmx-thesis-banner">
            <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <strong>HỆ THỐNG SIÊU THỊ ĐIỆN MÁY XANH</strong> - Chuyên phân phối Tivi, Tủ lạnh, Máy giặt, Máy lạnh, Điện thoại, Laptop, Gia dụng chính hãng
                </div>
                <div>
                    Hotline CSKH: <strong>1900 232 461</strong>
                </div>
            </div>
        </div>
    </footer>

    <!-- Thanh so sánh sản phẩm nổi (Compare Bar) -->
    <div id="dmxCompareBar" class="dmx-compare-bar d-none">
        <div class="d-flex align-items-center gap-2" id="dmxCompareItems">
            <!-- Nạp động qua JS -->
        </div>
        <div class="d-flex align-items-center gap-2 border-start ps-3">
            <a asp-controller="Product" asp-action="Compare" id="btnGoToCompare" class="btn btn-primary btn-sm fw-bold rounded-pill px-3 py-1">
                <i class="bi bi-arrow-left-right me-1"></i>So sánh ngay (<span id="dmxCompareCount">0</span>)
            </a>
            <button type="button" class="btn btn-light btn-sm text-muted rounded-pill px-2 py-1" id="btnClearCompareBar" title="Làm trống">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            window.dmxNotification = { type: "success", message: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["SuccessMessage"])) };
        </script>
    }
    else if (TempData["ErrorMessage"] != null)
    {
        <script>
            window.dmxNotification = { type: "error", message: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ErrorMessage"])) };
        </script>
    }
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
