@{
    ViewData["Title"] = "Giới thiệu Hệ thống Siêu thị Điện Máy Xanh";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb bg-white p-3 rounded-3 shadow-sm mb-0">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-primary">Trang chủ</a></li>
        <li class="breadcrumb-item active" aria-current="page">Giới thiệu hệ thống</li>
    </ol>
</nav>

<div class="dmx-section-card">
    <div class="text-center border-bottom pb-4 mb-4">
        <h3 class="fw-black text-primary mb-2 text-uppercase">Hệ Thống Siêu Thị Điện Máy Xanh</h3>
        <div class="text-muted">Chuyên cung cấp các sản phẩm Tivi, Tủ lạnh, Máy giặt, Máy lạnh, Điện thoại, Laptop và Gia dụng chính hãng</div>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="p-3 rounded-3 border bg-light h-100">
                <h5 class="fw-bold text-primary mb-3"><i class="bi bi-building-check me-2"></i>Tầm nhìn & Sứ mệnh</h5>
                <p class="mb-2">
                    Hệ thống Siêu thị Điện Máy Xanh mang đến cho người tiêu dùng trải nghiệm mua sắm thiết bị điện tử và điện lạnh trực tuyến hiện đại, minh bạch về giá cả và đảm bảo 100% sản phẩm chính hãng từ các thương hiệu hàng đầu thế giới.
                </p>
                <ul class="mb-0 ps-3">
                    <li class="mb-1">Đa dạng ngành hàng: Tivi, Tủ lạnh, Máy giặt, Điều hòa, Điện thoại, Laptop, Gia dụng, Máy lọc nước.</li>
                    <li class="mb-1">Mức giá cạnh tranh kèm chương trình Giờ vàng Giá sốc mỗi ngày.</li>
                    <li>Hệ thống tra cứu đơn hàng và bảo hành điện tử nhanh chóng, tiện lợi.</li>
                </ul>
            </div>
        </div>

        <div class="col-md-6">
            <div class="p-3 rounded-3 border bg-light h-100">
                <h5 class="fw-bold text-primary mb-3"><i class="bi bi-award-fill me-2"></i>Cam kết dịch vụ khách hàng</h5>
                <ul class="mb-0 ps-3">
                    <li class="mb-2"><strong>1 đổi 1 trong 30 ngày:</strong> Đổi sản phẩm mới ngay tại nhà nếu phát sinh lỗi kỹ thuật từ nhà sản xuất.</li>
                    <li class="mb-2"><strong>Giao hàng & Lắp đặt miễn phí:</strong> Đội ngũ kỹ thuật viên chuyên nghiệp giao lắp tận nơi trên toàn quốc.</li>
                    <li class="mb-2"><strong>Hỗ trợ trả góp 0% lãi suất:</strong> Thủ tục đơn giản, xét duyệt nhanh chóng.</li>
                    <li><strong>Tổng đài hỗ trợ tận tâm:</strong> Tư vấn mua hàng 1900 232 461 (8:00 - 21:30 tất cả các ngày trong tuần).</li>
                </ul>
            </div>
        </div>
    </div>
</div>
