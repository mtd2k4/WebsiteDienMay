@model WebsiteDienMay.Models.ProductListViewModel
@{
    ViewData["Title"] = Model.CurrentCategory != null ? $"{Model.CurrentCategory.Name} chính hãng giá tốt" : "Danh sách thiết bị điện tử";
    var priceRanges = new Dictionary<string, string>
    {
        { "", "Tất cả mức giá" },
        { "under-5m", "Dưới 5 triệu" },
        { "5m-10m", "Từ 5 - 10 triệu" },
        { "10m-15m", "Từ 10 - 15 triệu" },
        { "15m-25m", "Từ 15 - 25 triệu" },
        { "over-25m", "Trên 25 triệu" }
    };
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb bg-white p-3 rounded-3 shadow-sm mb-0 border">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-primary fw-semibold">Trang chủ</a></li>
        @if (Model.CurrentCategory != null)
        {
            <li class="breadcrumb-item active fw-semibold" aria-current="page">@Model.CurrentCategory.Name</li>
        }
        else
        {
            <li class="breadcrumb-item active fw-semibold" aria-current="page">Tất cả thiết bị điện tử</li>
        }
    </ol>
</nav>

<!-- Banner đôi đầu trang danh mục -->
@if (Model.CurrentCategory != null && !string.IsNullOrEmpty(Model.CurrentCategory.BannerUrl))
{
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <div class="dmx-sub-banner">
                <img src="@Model.CurrentCategory.BannerUrl" alt="@Model.CurrentCategory.Name" />
            </div>
        </div>
        <div class="col-md-6">
            <div class="dmx-sub-banner">
                <img src="https://cdnv2.tgdd.vn/mwg-static/common/Banner/5c/e5/5ce5c8d856c99ef01528033c294d6389.png" alt="Khuyến mãi @Model.CurrentCategory.Name" />
            </div>
        </div>
    </div>
}

<!-- Thanh lọc nhanh Thương hiệu chính hãng -->
<div class="dmx-section-card py-3 mb-3">
    <div class="d-flex align-items-center flex-wrap gap-2">
        <span class="fw-bold small text-uppercase text-muted me-1"><i class="bi bi-award text-primary me-1"></i>Thương hiệu:</span>
        <a asp-action="Index"
           asp-route-categoryId="@Model.SelectedCategoryId"
           asp-route-priceRange="@Model.PriceRange"
           asp-route-keyword="@Model.SearchKeyword"
           asp-route-sort="@Model.SortOrder"
           class="dmx-brand-pill @(Model.SelectedBrandId == null ? "active fw-bold text-primary" : "")">
            Tất cả hãng
        </a>
        @foreach (var brand in Model.Brands)
        {
            <a asp-action="Index"
               asp-route-categoryId="@Model.SelectedCategoryId"
               asp-route-brandId="@brand.Id"
               asp-route-priceRange="@Model.PriceRange"
               asp-route-keyword="@Model.SearchKeyword"
               asp-route-sort="@Model.SortOrder"
               class="dmx-brand-pill @(Model.SelectedBrandId == brand.Id ? "active" : "")"
               title="@brand.Name">
                <img src="@brand.LogoUrl" alt="@brand.Name" />
            </a>
        }
    </div>
</div>

<!-- Bố cục 2 cột chuẩn TMĐT: Sidebar Lọc bên trái + Danh sách Sản phẩm bên phải -->
<div class="row g-3">
    <!-- Cột trái: Bộ lọc chuyên sâu -->
    <div class="col-lg-3">
        <div class="dmx-filter-sidebar">
            <div class="d-flex align-items-center justify-content-between border-bottom pb-2 mb-3">
                <span class="fw-black text-uppercase text-primary"><i class="bi bi-funnel-fill me-1"></i>Bộ lọc tìm kiếm</span>
                @if (Model.SelectedCategoryId != null || Model.SelectedBrandId != null || !string.IsNullOrEmpty(Model.PriceRange) || !string.IsNullOrEmpty(Model.SearchKeyword))
                {
                    <a asp-action="Index" class="small text-danger fw-semibold">Đặt lại</a>
                }
            </div>

            <!-- Nhóm 1: Danh mục ngành hàng -->
            <div class="mb-4">
                <div class="dmx-filter-group-title">
                    <i class="bi bi-grid-fill text-primary"></i>
                    <span>Ngành hàng</span>
                </div>
                <a asp-action="Index"
                   asp-route-brandId="@Model.SelectedBrandId"
                   asp-route-priceRange="@Model.PriceRange"
                   asp-route-keyword="@Model.SearchKeyword"
                   class="dmx-filter-cate-item @(Model.SelectedCategoryId == null ? "active" : "")">
                    <i class="bi bi-collection"></i>
                    <span>Tất cả ngành hàng</span>
                </a>
                @foreach (var cat in Model.Categories)
                {
                    <a asp-action="Index"
                       asp-route-categoryId="@cat.Id"
                       asp-route-brandId="@Model.SelectedBrandId"
                       asp-route-priceRange="@Model.PriceRange"
                       asp-route-keyword="@Model.SearchKeyword"
                       class="dmx-filter-cate-item @(Model.SelectedCategoryId == cat.Id ? "active" : "")">
                        <img src="@cat.IconUrl" alt="@cat.Name" style="width: 24px; height: 24px; object-fit: contain;" />
                        <span>@cat.Name</span>
                    </a>
                }
            </div>

            <!-- Nhóm 2: Khoảng giá -->
            <div class="mb-3">
                <div class="dmx-filter-group-title">
                    <i class="bi bi-cash-stack text-primary"></i>
                    <span>Khoảng giá</span>
                </div>
                <div class="d-flex flex-column gap-1">
                    @foreach (var pr in priceRanges)
                    {
                        var isActive = (Model.PriceRange ?? "") == pr.Key;
                        <a asp-action="Index"
                           asp-route-categoryId="@Model.SelectedCategoryId"
                           asp-route-brandId="@Model.SelectedBrandId"
                           asp-route-priceRange="@pr.Key"
                           asp-route-keyword="@Model.SearchKeyword"
                           asp-route-sort="@Model.SortOrder"
                           class="dmx-filter-cate-item @(isActive ? "active" : "")">
                            <i class="bi @(isActive ? "bi-record-circle-fill text-primary" : "bi-circle text-muted")"></i>
                            <span>@pr.Value</span>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Cột phải: Thanh sắp xếp & Lưới sản phẩm -->
    <div class="col-lg-9">
        <div class="dmx-section-card mb-0">
            <!-- Thanh Header & Sắp xếp -->
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 border-bottom pb-3 mb-3">
                <div>
                    <h5 class="fw-black m-0 d-inline-block">
                        @if (Model.CurrentCategory != null)
                        {
                            <span>@Model.CurrentCategory.Name</span>
                        }
                        else if (!string.IsNullOrEmpty(Model.SearchKeyword))
                        {
                            <span>Kết quả tìm kiếm: "@Model.SearchKeyword"</span>
                        }
                        else
                        {
                            <span>Tất cả thiết bị điện tử</span>
                        }
                    </h5>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-2">@Model.TotalItems sản phẩm</span>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-1">
                    <span class="small text-muted fw-semibold me-1">Xếp theo:</span>
                    <a asp-action="Index" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-brandId="@Model.SelectedBrandId" asp-route-priceRange="@Model.PriceRange" asp-route-keyword="@Model.SearchKeyword"
                       class="btn btn-sm @(string.IsNullOrEmpty(Model.SortOrder) ? "btn-primary fw-semibold" : "btn-light border")">Nổi bật</a>
                    <a asp-action="Index" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-brandId="@Model.SelectedBrandId" asp-route-priceRange="@Model.PriceRange" asp-route-keyword="@Model.SearchKeyword" asp-route-sort="bestseller"
                       class="btn btn-sm @(Model.SortOrder == "bestseller" ? "btn-primary fw-semibold" : "btn-light border")">Bán chạy</a>
                    <a asp-action="Index" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-brandId="@Model.SelectedBrandId" asp-route-priceRange="@Model.PriceRange" asp-route-keyword="@Model.SearchKeyword" asp-route-sort="discount"
                       class="btn btn-sm @(Model.SortOrder == "discount" ? "btn-primary fw-semibold" : "btn-light border")">% Giảm nhiều</a>
                    <a asp-action="Index" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-brandId="@Model.SelectedBrandId" asp-route-priceRange="@Model.PriceRange" asp-route-keyword="@Model.SearchKeyword" asp-route-sort="price-asc"
                       class="btn btn-sm @(Model.SortOrder == "price-asc" ? "btn-primary fw-semibold" : "btn-light border")">Giá thấp - cao</a>
                    <a asp-action="Index" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-brandId="@Model.SelectedBrandId" asp-route-priceRange="@Model.PriceRange" asp-route-keyword="@Model.SearchKeyword" asp-route-sort="price-desc"
                       class="btn btn-sm @(Model.SortOrder == "price-desc" ? "btn-primary fw-semibold" : "btn-light border")">Giá cao - thấp</a>
                </div>
            </div>

            @if (!Model.Products.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-search fs-1 text-muted"></i>
                    <h5 class="mt-3 fw-bold">Không tìm thấy sản phẩm phù hợp với bộ lọc</h5>
                    <p class="text-muted">Vui lòng thử chọn khoảng giá khác hoặc xóa bộ lọc để xem toàn bộ sản phẩm.</p>
                    <a asp-action="Index" class="btn btn-primary fw-bold px-4">Xem tất cả sản phẩm</a>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var item in Model.Products)
                    {
                        <div class="col-xl-4 col-md-6">
                            <partial name="_ProductCard" model="item" />
                        </div>
                    }
                </div>

                @if (Model.TotalPages > 1)
                {
                    <nav class="mt-4 d-flex justify-content-center">
                        <ul class="pagination mb-0">
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link fw-semibold"
                                       asp-action="Index"
                                       asp-route-categoryId="@Model.SelectedCategoryId"
                                       asp-route-brandId="@Model.SelectedBrandId"
                                       asp-route-priceRange="@Model.PriceRange"
                                       asp-route-keyword="@Model.SearchKeyword"
                                       asp-route-sort="@Model.SortOrder"
                                       asp-route-page="@i">@i</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>
