@model WebsiteDienMay.Models.Order
@{
    ViewData["Title"] = "Hoàn tất đặt hàng - " + Model.OrderCode;
}

<!-- Thanh tiến trình mua hàng 3 bước -->
<div class="dmx-stepper d-none d-md-flex">
    <div class="dmx-step-item completed">
        <span class="dmx-step-circle"><i class="bi bi-check-lg"></i></span>
        <span>Giỏ hàng</span>
    </div>
    <div class="dmx-step-line"></div>
    <div class="dmx-step-item completed">
        <span class="dmx-step-circle"><i class="bi bi-check-lg"></i></span>
        <span>Thông tin đặt hàng & Thanh toán</span>
    </div>
    <div class="dmx-step-line"></div>
    <div class="dmx-step-item completed">
        <span class="dmx-step-circle"><i class="bi bi-check-lg"></i></span>
        <span>Hoàn tất đơn hàng</span>
    </div>
</div>

<div class="dmx-section-card mx-auto" style="max-width: 860px;">
    <div class="text-center border-bottom pb-4 mb-4">
        <div class="mb-2">
            <span class="d-inline-flex align-items-center justify-content-center bg-success-subtle text-success rounded-circle" style="width: 72px; height: 72px;">
                <i class="bi bi-check-circle-fill fs-1"></i>
            </span>
        </div>
        <h3 class="fw-black text-success mt-2">ĐẶT HÀNG THÀNH CÔNG</h3>
        <p class="text-muted mb-2">Cảm ơn quý khách <strong>@Model.CustomerName</strong> đã tin tưởng mua sắm tại Siêu thị Điện Máy Xanh.</p>
        <div class="d-inline-block px-4 py-2 rounded-pill bg-primary-subtle text-primary fw-bold fs-6 border border-primary-subtle">
            Mã đơn hàng: @Model.OrderCode
        </div>
    </div>

    @if (Model.PaymentMethod == "Banking" || Model.PaymentMethod.Contains("Chuyển khoản", StringComparison.OrdinalIgnoreCase))
    {
        var vietQrUrl = $"https://img.vietqr.io/image/MB-0988123456-compact2.png?amount={(long)Model.TotalAmount}&addInfo={Model.OrderCode}&accountName=SIEU%20THI%20DIEN%20MAY%20XANH";
        <div class="card border-primary mb-4 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-primary text-white py-3 px-4 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-qr-code-scan fs-4"></i>
                    <div>
                        <h6 class="mb-0 fw-bold">QUÉT MÃ VIETQR ĐỂ THANH TOÁN TỰ ĐỘNG</h6>
                        <small class="opacity-75">Hỗ trợ tất cả ứng dụng Ngân hàng (MB, VCB, Techcombank, Vietinbank, Momo...)</small>
                    </div>
                </div>
                <span class="badge bg-warning text-dark font-monospace fw-bold">NAPAS 247</span>
            </div>
            <div class="card-body p-4 bg-light">
                <div class="row align-items-center g-4">
                    <div class="col-md-5 text-center">
                        <div class="bg-white p-3 rounded-3 border d-inline-block shadow-sm">
                            <img src="@vietQrUrl" alt="VietQR Thanh toán Điện Máy Xanh" class="img-fluid rounded" style="max-width: 230px;" />
                            <div class="text-muted small mt-2">
                                <i class="bi bi-shield-check text-success me-1"></i>Chuẩn thanh toán VietQR Quốc gia
                            </div>
                        </div>
                    </div>
                    <div class="col-md-7">
                        <h6 class="fw-bold text-dark mb-3">Thông tin chuyển khoản ngân hàng:</h6>
                        <ul class="list-group list-group-flush border rounded-3 bg-white mb-3">
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span class="text-muted">Ngân hàng thụ hưởng:</span>
                                <strong class="text-dark">MBBank (Ngân hàng TMCP Quân Đội)</strong>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span class="text-muted">Chủ tài khoản:</span>
                                <strong class="text-primary text-uppercase">SIEU THI DIEN MAY XANH</strong>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span class="text-muted">Số tài khoản:</span>
                                <div class="d-flex align-items-center gap-2">
                                    <strong class="font-monospace fs-6 text-dark">0988123456</strong>
                                    <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" onclick="navigator.clipboard.writeText('0988123456'); if(typeof Swal !== 'undefined') Swal.fire({toast:true, position:'top-end', icon:'success', title:'Đã sao chép STK', timer:1500, showConfirmButton:false});" title="Sao chép STK">
                                        <i class="bi bi-copy"></i>
                                    </button>
                                </div>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span class="text-muted">Số tiền cần thanh toán:</span>
                                <strong class="fs-5 text-danger font-monospace">@Model.TotalAmount.ToString("N0") đ</strong>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center bg-warning-subtle">
                                <span class="fw-bold text-dark">Nội dung chuyển khoản (Bắt buộc):</span>
                                <div class="d-flex align-items-center gap-2">
                                    <strong class="font-monospace fs-6 text-primary">@Model.OrderCode</strong>
                                    <button type="button" class="btn btn-primary btn-sm py-0 px-2" onclick="navigator.clipboard.writeText('@Model.OrderCode'); if(typeof Swal !== 'undefined') Swal.fire({toast:true, position:'top-end', icon:'success', title:'Đã sao chép Mã đơn', timer:1500, showConfirmButton:false});" title="Sao chép mã đơn">
                                        <i class="bi bi-copy"></i>
                                    </button>
                                </div>
                            </li>
                        </ul>
                        <div class="alert alert-info py-2 px-3 small mb-0">
                            <i class="bi bi-info-circle-fill me-1"></i>Hệ thống sẽ tự động xác nhận đơn hàng ngay khi nhận được thanh toán từ tài khoản ngân hàng của quý khách.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (Model.PaymentMethod == "Installment" && !string.IsNullOrEmpty(Model.InstallmentInfo))
    {
        <div class="card border-warning mb-4 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-warning text-dark py-3 px-4 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-credit-card-2-front-fill fs-4"></i>
                    <div>
                        <h6 class="mb-0 fw-black">HỒ SƠ ĐĂNG KÝ TRẢ GÓP 0% LÃI SUẤT ĐÃ GHI NHẬN</h6>
                        <small>Chuyên viên tài chính Điện Máy Xanh sẽ liên hệ xác nhận hồ sơ trong 5 - 10 phút</small>
                    </div>
                </div>
                <span class="badge bg-dark text-warning fw-bold">LÃI SUẤT 0%</span>
            </div>
            <div class="card-body p-4 bg-warning-subtle">
                <div class="fw-bold text-dark mb-1">Chi tiết phương án trả góp đã chọn:</div>
                <div class="p-3 bg-white rounded-3 border border-warning fw-semibold text-primary mb-2">
                    <i class="bi bi-check-circle-fill text-success me-1"></i>@Model.InstallmentInfo
                </div>
                <div class="small text-muted">
                    <i class="bi bi-info-circle me-1"></i>Vui lòng chuẩn bị sẵn CCCD gắn chip (nếu trả góp qua Công ty tài chính) hoặc Thẻ tín dụng chính chủ để hoàn tất thủ tục duyệt tự động.
                </div>
            </div>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="p-3 border rounded-3 bg-light h-100">
                <h6 class="fw-black text-primary text-uppercase mb-2"><i class="bi bi-person-lines-fill me-2"></i>Thông tin người nhận</h6>
                <div class="small mb-1"><strong>Khách hàng:</strong> @Model.CustomerName</div>
                <div class="small mb-1"><strong>Số điện thoại:</strong> @Model.CustomerPhone</div>
                @if (!string.IsNullOrEmpty(Model.CustomerEmail))
                {
                    <div class="small mb-1"><strong>Email:</strong> @Model.CustomerEmail</div>
                }
                <div class="small mb-1"><strong>Địa chỉ giao & lắp đặt:</strong> @Model.ShippingAddress</div>
                @if (!string.IsNullOrEmpty(Model.Note))
                {
                    <div class="small"><strong>Ghi chú:</strong> @Model.Note</div>
                }
            </div>
        </div>

        <div class="col-md-6">
            <div class="p-3 border rounded-3 bg-light h-100">
                <h6 class="fw-black text-primary text-uppercase mb-2"><i class="bi bi-receipt me-2"></i>Thông tin thanh toán & Thuế GTGT</h6>
                <div class="small mb-1"><strong>Thời gian đặt:</strong> @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                <div class="small mb-1"><strong>Hình thức thanh toán:</strong> @Model.PaymentMethod</div>
                @if (!string.IsNullOrEmpty(Model.InstallmentInfo))
                {
                    <div class="small mb-1"><strong>Gói trả góp:</strong> <span class="text-primary fw-semibold">@Model.InstallmentInfo</span></div>
                }
                <div class="small mb-1"><strong>Trạng thái thanh toán:</strong> @Model.PaymentStatus</div>
                <div class="small mb-1"><strong>Trạng thái xử lý:</strong> <span class="badge bg-warning text-dark">@Model.OrderStatus</span></div>
                @if (Model.RequireVatInvoice)
                {
                    <div class="mt-2 pt-2 border-top small">
                        <div class="fw-bold text-success"><i class="bi bi-Patch-check-fill me-1"></i>Xuất hóa đơn GTGT (VAT 8%) Công ty:</div>
                        <div><strong>Đơn vị:</strong> @Model.CompanyName (MST: <span class="font-monospace">@Model.CompanyTaxCode</span>)</div>
                        <div><strong>Địa chỉ:</strong> @Model.CompanyAddress</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <h6 class="fw-black text-uppercase mb-2">Danh sách thiết bị đặt mua</h6>
    <div class="table-responsive mb-4">
        <table class="table table-bordered align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Sản phẩm</th>
                    <th class="text-center" style="width: 100px;">Số lượng</th>
                    <th class="text-end" style="width: 150px;">Đơn giá</th>
                    <th class="text-end" style="width: 150px;">Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderDetails)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <img src="@item.ProductImage" alt="@item.ProductName" style="width: 50px; height: 50px; object-fit: contain;" />
                                <div>
                                    <div class="fw-semibold">@item.ProductName</div>
                                    @if (!string.IsNullOrEmpty(item.SelectedVariant))
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle mt-1">Phiên bản: @item.SelectedVariant</span>
                                    }
                                </div>
                            </div>
                        </td>
                        <td class="text-center fw-bold">@item.Quantity</td>
                        <td class="text-end">@item.UnitPrice.ToString("N0") đ</td>
                        <td class="text-end fw-bold text-danger">@((item.UnitPrice * item.Quantity).ToString("N0")) đ</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3" class="text-end">Tạm tính tiền hàng:</td>
                    <td class="text-end fw-semibold">@Model.SubTotal.ToString("N0") đ</td>
                </tr>
                <tr>
                    <td colspan="3" class="text-end">Giảm giá ưu đãi @(string.IsNullOrEmpty(Model.CouponCode) ? "" : $"({Model.CouponCode})"):</td>
                    <td class="text-end text-success fw-semibold">-@Model.DiscountAmount.ToString("N0") đ</td>
                </tr>
                <tr>
                    <td colspan="3" class="text-end">Thuế GTGT (VAT 8%):</td>
                    <td class="text-end fw-semibold">+@Model.VatAmount.ToString("N0") đ</td>
                </tr>
                <tr>
                    <td colspan="3" class="text-end fw-bold">Tổng thanh toán (Đã gồm VAT):</td>
                    <td class="text-end fw-black fs-5 text-danger">@Model.TotalAmount.ToString("N0") đ</td>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="d-flex flex-wrap justify-content-center gap-3">
        <a asp-action="TrackOrder" asp-route-keyword="@Model.OrderCode" class="btn btn-outline-primary px-4 fw-bold">
            <i class="bi bi-truck me-1"></i>Theo dõi tiến độ đơn hàng
        </a>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 fw-bold">
            <i class="bi bi-bag-check me-1"></i>Tiếp tục mua sắm
        </a>
    </div>
</div>
