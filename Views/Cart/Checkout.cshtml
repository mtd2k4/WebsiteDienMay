@model WebsiteDienMay.Models.CheckoutViewModel
@{
    ViewData["Title"] = "Thông tin Đặt hàng & Thanh toán";
    var totalQty = Model.Cart.Items.Sum(x => x.Quantity);
}

<!-- Thanh tiến trình mua hàng 3 bước -->
<div class="dmx-stepper d-none d-md-flex">
    <a asp-action="Index" class="dmx-step-item completed">
        <span class="dmx-step-circle"><i class="bi bi-check-lg"></i></span>
        <span>Giỏ hàng (@totalQty)</span>
    </a>
    <div class="dmx-step-line"></div>
    <div class="dmx-step-item active">
        <span class="dmx-step-circle">2</span>
        <span>Thông tin đặt hàng & Thanh toán</span>
    </div>
    <div class="dmx-step-line"></div>
    <div class="dmx-step-item">
        <span class="dmx-step-circle">3</span>
        <span>Hoàn tất đơn hàng</span>
    </div>
</div>

<form asp-action="Checkout" method="post" id="checkoutForm">
    @Html.AntiForgeryToken()
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="dmx-section-card">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 border-bottom pb-3 mb-3">
                    <h5 class="fw-black m-0">
                        <i class="bi bi-geo-alt-fill text-primary me-2"></i>1. Thông tin người nhận & Địa chỉ hành chính mới
                    </h5>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                        <i class="bi bi-map me-1"></i>Chuẩn 34 Tỉnh/Thành - Phường/Xã mới
                    </span>
                </div>

                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Họ và tên người nhận <span class="text-danger">*</span></label>
                        <input asp-for="CustomerName" class="form-control" placeholder="Nhập họ và tên người nhận" required />
                        <span asp-validation-for="CustomerName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Số điện thoại liên hệ <span class="text-danger">*</span></label>
                        <input asp-for="CustomerPhone" type="tel" maxlength="10" pattern="0[35789][0-9]{8}" class="form-control" placeholder="10 chữ số (VD: 0988123456)" oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10);" required />
                        <span asp-validation-for="CustomerPhone" class="text-danger small"></span>
                    </div>
                    <div class="col-md-12">
                        <label class="form-label fw-semibold small">Email nhận hóa đơn điện tử & bảo hành</label>
                        <input asp-for="CustomerEmail" type="email" class="form-control" placeholder="Nhập địa chỉ email (không bắt buộc)" />
                    </div>

                    <!-- Cụm chọn Địa chỉ hành chính mới (2 cấp: Tỉnh/Thành phố -> Phường/Xã/Đặc khu) -->
                    <div class="col-md-6">
                        <label for="provinceSelect" class="form-label fw-semibold small">
                            Tỉnh / Thành phố <span class="text-danger">*</span>
                        </label>
                        <select id="provinceSelect" name="ProvinceCode" class="form-select" required>
                            <option value="">-- Đang tải 34 Tỉnh / Thành phố... --</option>
                        </select>
                        <input type="hidden" asp-for="ProvinceName" id="provinceNameInput" />
                        <span asp-validation-for="ProvinceName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label for="wardSelect" class="form-label fw-semibold small">
                            Phường / Xã / Đặc khu <span class="text-danger">*</span>
                        </label>
                        <select id="wardSelect" name="WardCode" class="form-select" required disabled>
                            <option value="">-- Chọn Tỉnh / Thành phố trước --</option>
                        </select>
                        <input type="hidden" asp-for="WardName" id="wardNameInput" />
                        <span asp-validation-for="WardName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="AddressDetail" class="form-label fw-semibold small">
                            Số nhà, tên đường / thôn / khu dân cư <span class="text-danger">*</span>
                        </label>
                        <input asp-for="AddressDetail" id="addressDetailInput" class="form-control" placeholder="Ví dụ: Số 9 Đường Tiên Sơn, Khu phố 3..." required />
                        <span asp-validation-for="AddressDetail" class="text-danger small"></span>
                    </div>

                    <!-- Xem trước địa chỉ giao hàng đầy đủ -->
                    <div class="col-md-12">
                        <input type="hidden" asp-for="ShippingAddress" id="shippingAddressHidden" />
                        <div class="p-3 rounded-3 bg-light border d-flex align-items-start gap-2">
                            <i class="bi bi-pin-map-fill text-primary mt-1"></i>
                            <div class="small">
                                <div class="text-muted fw-semibold">Địa chỉ giao hàng & lắp đặt đầy đủ:</div>
                                <div id="fullAddressPreview" class="fw-bold text-dark mt-1">
                                    Vui lòng chọn Tỉnh/Thành phố, Phường/Xã và nhập số nhà, tên đường
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label fw-semibold small">Yêu cầu kỹ thuật / Ghi chú giao hàng</label>
                        <textarea asp-for="Note" rows="2" class="form-control" placeholder="Ví dụ: Giao trong giờ hành chính, hỗ trợ lắp đặt treo tường, gọi trước 30 phút..."></textarea>
                    </div>
                </div>

                <h5 class="fw-black border-bottom pb-3 mt-4 mb-3">
                    <i class="bi bi-credit-card-2-front-fill text-primary me-2"></i>2. Chọn phương thức thanh toán
                </h5>

                <div class="d-flex flex-column gap-2">
                    <label class="p-3 border rounded-3 d-flex align-items-start gap-3 bg-light" style="cursor: pointer;">
                        <input type="radio" asp-for="PaymentMethod" value="COD" class="form-check-input mt-1" checked />
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center justify-content-between">
                                <span class="fw-bold text-dark">Thanh toán tiền mặt khi nhận hàng (COD)</span>
                                <span class="badge bg-primary-subtle text-primary">Phổ biến nhất</span>
                            </div>
                            <div class="small text-muted mt-1">Nhân viên kỹ thuật Điện Máy Xanh giao hàng, lắp đặt hoàn chỉnh và kiểm tra vận hành mới thu tiền.</div>
                        </div>
                    </label>

                    <label class="p-3 border rounded-3 d-flex align-items-start gap-3 bg-white" style="cursor: pointer;">
                        <input type="radio" asp-for="PaymentMethod" value="Banking" class="form-check-input mt-1" />
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center justify-content-between">
                                <span class="fw-bold text-dark">Chuyển khoản ngân hàng / Quét mã VietQR 24/7</span>
                                <span class="badge bg-success-subtle text-success">Xác nhận tự động</span>
                            </div>
                            <div class="small text-muted mt-1">Hỗ trợ thanh toán nhanh qua ứng dụng Mobile Banking của tất cả ngân hàng nội địa.</div>
                        </div>
                    </label>

                    <label class="p-3 border rounded-3 d-flex align-items-start gap-3 bg-white" style="cursor: pointer;">
                        <input type="radio" asp-for="PaymentMethod" value="Installment" class="form-check-input mt-1" />
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center justify-content-between">
                                <span class="fw-bold text-dark">Đăng ký Trả góp 0% lãi suất</span>
                                <span class="badge bg-warning text-dark">Kỳ hạn 6 - 12 tháng</span>
                            </div>
                            <div class="small text-muted mt-1">Xét duyệt hồ sơ trực tuyến qua thẻ tín dụng hoặc CCCD gắn chip trong 5 phút.</div>
                        </div>
                    </label>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="dmx-section-card position-sticky" style="top: 120px;">
                <div class="d-flex align-items-center justify-content-between border-bottom pb-3 mb-3">
                    <h5 class="fw-black m-0">Tóm tắt đơn hàng (@totalQty)</h5>
                    <a asp-action="Index" class="small text-primary fw-semibold">Sửa giỏ hàng</a>
                </div>

                <div class="mb-3" style="max-height: 310px; overflow-y: auto;">
                    @foreach (var item in Model.Cart.Items)
                    {
                        <div class="d-flex align-items-center justify-content-between gap-2 border-bottom py-2">
                            <div class="d-flex align-items-center gap-2">
                                <img src="@item.ImageUrl" alt="@item.ProductName" class="border rounded p-1" style="width: 54px; height: 54px; object-fit: contain;" />
                                <div>
                                    <div class="fw-semibold small">@item.ProductName</div>
                                    <div class="small text-muted">Số lượng: <strong>@item.Quantity</strong> x @item.UnitPrice.ToString("N0") đ</div>
                                </div>
                            </div>
                            <div class="fw-bold text-danger small text-nowrap">@item.Total.ToString("N0") đ</div>
                        </div>
                    }
                </div>

                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Tạm tính:</span>
                    <span class="fw-bold">@Model.Cart.SubTotal.ToString("N0") đ</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Giảm giá Voucher @(string.IsNullOrEmpty(Model.Cart.CouponCode) ? "" : $"({Model.Cart.CouponCode})"):</span>
                    <span class="text-success fw-bold">-@Model.Cart.DiscountAmount.ToString("N0") đ</span>
                </div>
                <div class="d-flex justify-content-between mb-3">
                    <span class="text-muted">Vận chuyển & Công lắp đặt:</span>
                    <span class="badge bg-success-subtle text-success border border-success-subtle">Miễn phí</span>
                </div>

                <div class="d-flex justify-content-between align-items-center border-top pt-3 mb-3">
                    <span class="fw-bold fs-6">Tổng thanh toán:</span>
                    <span class="fw-black fs-3 text-danger">@Model.Cart.FinalTotal.ToString("N0") đ</span>
                </div>

                <button type="submit" class="dmx-buy-now-btn text-uppercase fs-6">
                    <i class="bi bi-check2-circle me-1"></i>Xác nhận đặt mua ngay
                </button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const API_BASE = "https://provinces.open-api.vn/api/v2";
            const provinceSelect = document.getElementById("provinceSelect");
            const wardSelect = document.getElementById("wardSelect");
            const provinceNameInput = document.getElementById("provinceNameInput");
            const wardNameInput = document.getElementById("wardNameInput");
            const addressDetailInput = document.getElementById("addressDetailInput");
            const shippingAddressHidden = document.getElementById("shippingAddressHidden");
            const fullAddressPreview = document.getElementById("fullAddressPreview");
            const checkoutForm = document.getElementById("checkoutForm");

            const initialProvinceCode = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProvinceCode?.ToString() ?? ""));
            const initialWardCode = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WardCode?.ToString() ?? ""));
            const savedUserAddress = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ShippingAddress ?? ""));

            function normalizeText(str) {
                return (str || "")
                    .toLowerCase()
                    .replace(/^(tỉnh|thành phố|tp\.?|phường|xã|đặc khu)\s+/i, "")
                    .trim();
            }

            function updateFullAddress() {
                const pOption = provinceSelect.options[provinceSelect.selectedIndex];
                const wOption = wardSelect.options[wardSelect.selectedIndex];

                const pName = (provinceSelect.value && pOption) ? pOption.dataset.name || pOption.text : "";
                const wName = (wardSelect.value && wOption) ? wOption.dataset.name || wOption.text : "";
                const detail = (addressDetailInput.value || "").trim();

                provinceNameInput.value = pName;
                wardNameInput.value = wName;

                const parts = [detail, wName, pName].filter(Boolean);
                if (parts.length > 0) {
                    const combined = parts.join(", ");
                    shippingAddressHidden.value = combined;
                    fullAddressPreview.textContent = combined;
                    fullAddressPreview.classList.remove("text-muted");
                    fullAddressPreview.classList.add("text-dark");
                } else {
                    shippingAddressHidden.value = "";
                    fullAddressPreview.textContent = "Vui lòng chọn Tỉnh/Thành phố, Phường/Xã và nhập số nhà, tên đường";
                }
            }

            async function fetchJsonWithFallback(primaryUrl, fallbackUrl) {
                try {
                    const res = await fetch(primaryUrl);
                    if (!res.ok) throw new Error("Primary API error");
                    return await res.json();
                } catch {
                    const fallbackRes = await fetch(fallbackUrl);
                    if (!fallbackRes.ok) throw new Error("Fallback API error");
                    return await fallbackRes.json();
                }
            }

            async function loadWards(provinceCode, autoMatchSaved) {
                wardSelect.innerHTML = '<option value="">-- Đang tải danh sách Phường / Xã... --</option>';
                wardSelect.disabled = true;

                if (!provinceCode) {
                    wardSelect.innerHTML = '<option value="">-- Chọn Tỉnh / Thành phố trước --</option>';
                    updateFullAddress();
                    return;
                }

                try {
                    const data = await fetchJsonWithFallback(
                        `${API_BASE}/p/${provinceCode}?depth=2`,
                        `/Cart/GetNewWards?code=${provinceCode}`
                    );

                    const wards = Array.isArray(data.wards) ? data.wards : [];
                    wardSelect.innerHTML = '<option value="">-- Chọn Phường / Xã / Đặc khu --</option>';

                    let matchedWardValue = "";
                    const lowerSaved = (savedUserAddress || "").toLowerCase();

                    wards.forEach(function (w) {
                        const opt = document.createElement("option");
                        opt.value = w.code;
                        opt.textContent = w.name;
                        opt.dataset.name = w.name;
                        wardSelect.appendChild(opt);

                        if (initialWardCode && String(w.code) === String(initialWardCode)) {
                            matchedWardValue = String(w.code);
                        } else if (autoMatchSaved && !matchedWardValue && lowerSaved) {
                            const cleanWard = normalizeText(w.name);
                            if (cleanWard.length >= 3 && lowerSaved.includes(cleanWard)) {
                                matchedWardValue = String(w.code);
                            }
                        }
                    });

                    wardSelect.disabled = false;
                    if (matchedWardValue) {
                        wardSelect.value = matchedWardValue;
                    }
                    updateFullAddress();
                } catch {
                    wardSelect.innerHTML = '<option value="">-- Không tải được Phường / Xã, vui lòng thử lại --</option>';
                    wardSelect.disabled = false;
                }
            }

            async function loadProvinces() {
                try {
                    const provinces = await fetchJsonWithFallback(
                        `${API_BASE}/p/`,
                        "/Cart/GetNewProvinces"
                    );

                    provinceSelect.innerHTML = '<option value="">-- Chọn Tỉnh / Thành phố --</option>';

                    let matchedProvinceValue = "";
                    const lowerSaved = (savedUserAddress || "").toLowerCase();

                    provinces.forEach(function (p) {
                        const opt = document.createElement("option");
                        opt.value = p.code;
                        opt.textContent = p.name;
                        opt.dataset.name = p.name;
                        provinceSelect.appendChild(opt);

                        if (initialProvinceCode && String(p.code) === String(initialProvinceCode)) {
                            matchedProvinceValue = String(p.code);
                        } else if (!initialProvinceCode && !matchedProvinceValue && lowerSaved) {
                            const cleanProv = normalizeText(p.name);
                            if (cleanProv && lowerSaved.includes(cleanProv)) {
                                matchedProvinceValue = String(p.code);
                            }
                        }
                    });

                    // Tự động điền phần số nhà/đường nếu địa chỉ tài khoản cũ có dấu phẩy
                    if (!addressDetailInput.value && savedUserAddress) {
                        const segments = savedUserAddress.split(",").map(s => s.trim()).filter(Boolean);
                        if (segments.length > 0) {
                            addressDetailInput.value = segments[0];
                        }
                    }

                    if (matchedProvinceValue) {
                        provinceSelect.value = matchedProvinceValue;
                        await loadWards(matchedProvinceValue, !initialWardCode);
                    } else {
                        updateFullAddress();
                    }
                } catch {
                    provinceSelect.innerHTML = '<option value="">-- Lỗi kết nối API Tỉnh / Thành phố --</option>';
                }
            }

            provinceSelect.addEventListener("change", function () {
                loadWards(this.value, false);
            });

            wardSelect.addEventListener("change", updateFullAddress);
            addressDetailInput.addEventListener("input", updateFullAddress);

            checkoutForm.addEventListener("submit", function (e) {
                updateFullAddress();
                if (!provinceSelect.value || !wardSelect.value || !addressDetailInput.value.trim()) {
                    e.preventDefault();
                    if (typeof Swal !== "undefined") {
                        Swal.fire({
                            icon: "warning",
                            title: "Thiếu thông tin địa chỉ nhận hàng",
                            text: "Vui lòng chọn đầy đủ Tỉnh/Thành phố, Phường/Xã và nhập số nhà, tên đường cụ thể.",
                            confirmButtonColor: "#2a83e9",
                            confirmButtonText: "Đã hiểu"
                        });
                    }
                }
            });

            loadProvinces();
        });
    </script>
}
