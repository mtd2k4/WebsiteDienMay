@model WebsiteDienMay.Models.CheckoutViewModel
@{
    ViewData["Title"] = "Thông tin Đặt hàng & Thanh toán";
    var totalQty = Model.Cart.Items.Sum(x => x.Quantity);
}

<!-- Thanh tiến trình mua hàng 3 bước -->
<div class="dmx-stepper d-none d-md-flex">
    <a asp-action="Index" class="dmx-step-item completed">
        <span class="dmx-step-circle"><i class="bi bi-check-lg"></i></span>
        <span>Giỏ hàng (@totalQty)</span>
    </a>
    <div class="dmx-step-line"></div>
    <div class="dmx-step-item active">
        <span class="dmx-step-circle">2</span>
        <span>Thông tin đặt hàng & Thanh toán</span>
    </div>
    <div class="dmx-step-line"></div>
    <div class="dmx-step-item">
        <span class="dmx-step-circle">3</span>
        <span>Hoàn tất đơn hàng</span>
    </div>
</div>

<form asp-action="Checkout" method="post" id="checkoutForm">
    @Html.AntiForgeryToken()
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="dmx-section-card">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 border-bottom pb-3 mb-3">
                    <h5 class="fw-black m-0">
                        <i class="bi bi-geo-alt-fill text-primary me-2"></i>1. Thông tin người nhận & Địa chỉ hành chính mới
                    </h5>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                        <i class="bi bi-map me-1"></i>Chuẩn 34 Tỉnh/Thành - Phường/Xã mới
                    </span>
                </div>

                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Họ và tên người nhận <span class="text-danger">*</span></label>
                        <input asp-for="CustomerName" class="form-control" placeholder="Nhập họ và tên người nhận" required />
                        <span asp-validation-for="CustomerName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Số điện thoại liên hệ <span class="text-danger">*</span></label>
                        <input asp-for="CustomerPhone" type="tel" maxlength="10" pattern="0[35789][0-9]{8}" class="form-control" placeholder="10 chữ số (VD: 0988123456)" oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10);" required />
                        <span asp-validation-for="CustomerPhone" class="text-danger small"></span>
                    </div>
                    <div class="col-md-12">
                        <label class="form-label fw-semibold small">Email nhận hóa đơn điện tử & bảo hành</label>
                        <input asp-for="CustomerEmail" type="email" class="form-control" placeholder="Nhập địa chỉ email (không bắt buộc)" />
                    </div>

                    <!-- Cụm chọn Địa chỉ hành chính mới (2 cấp: Tỉnh/Thành phố -> Phường/Xã/Đặc khu) -->
                    <div class="col-md-6">
                        <label for="provinceSelect" class="form-label fw-semibold small">
                            Tỉnh / Thành phố <span class="text-danger">*</span>
                        </label>
                        <select id="provinceSelect" name="ProvinceCode" class="form-select" required>
                            <option value="">-- Đang tải 34 Tỉnh / Thành phố... --</option>
                        </select>
                        <input type="hidden" asp-for="ProvinceName" id="provinceNameInput" />
                        <span asp-validation-for="ProvinceName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label for="wardSelect" class="form-label fw-semibold small">
                            Phường / Xã / Đặc khu <span class="text-danger">*</span>
                        </label>
                        <select id="wardSelect" name="WardCode" class="form-select" required disabled>
                            <option value="">-- Chọn Tỉnh / Thành phố trước --</option>
                        </select>
                        <input type="hidden" asp-for="WardName" id="wardNameInput" />
                        <span asp-validation-for="WardName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="AddressDetail" class="form-label fw-semibold small">
                            Số nhà, tên đường / thôn / khu dân cư <span class="text-danger">*</span>
                        </label>
                        <input asp-for="AddressDetail" id="addressDetailInput" class="form-control" placeholder="Ví dụ: Số 9 Đường Tiên Sơn, Khu phố 3..." required />
                        <span asp-validation-for="AddressDetail" class="text-danger small"></span>
                    </div>

                    <!-- Xem trước địa chỉ giao hàng đầy đủ -->
                    <div class="col-md-12">
                        <input type="hidden" asp-for="ShippingAddress" id="shippingAddressHidden" />
                        <div class="p-3 rounded-3 bg-light border d-flex align-items-start gap-2">
                            <i class="bi bi-pin-map-fill text-primary mt-1"></i>
                            <div class="small">
                                <div class="text-muted fw-semibold">Địa chỉ giao hàng & lắp đặt đầy đủ:</div>
                                <div id="fullAddressPreview" class="fw-bold text-dark mt-1">
                                    Vui lòng chọn Tỉnh/Thành phố, Phường/Xã và nhập số nhà, tên đường
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label fw-semibold small">Yêu cầu kỹ thuật / Ghi chú giao hàng</label>
                        <textarea asp-for="Note" rows="2" class="form-control" placeholder="Ví dụ: Giao trong giờ hành chính, hỗ trợ lắp đặt treo tường, gọi trước 30 phút..."></textarea>
                    </div>

                    <!-- Tùy chọn Xuất Hóa Đơn Điện Tử GTGT (VAT 8%) Công Ty -->
                    <div class="col-md-12">
                        <div class="p-3 rounded-3 border bg-white">
                            <div class="form-check">
                                <input asp-for="RequireVatInvoice" class="form-check-input" type="checkbox" id="requireVatCheckbox" />
                                <label class="form-check-label fw-bold text-dark" for="requireVatCheckbox" style="cursor: pointer;">
                                    <i class="bi bi-receipt-cutoff text-primary me-1"></i>Yêu cầu xuất hóa đơn điện tử GTGT (VAT 8%) cho Công ty / Tổ chức
                                </label>
                            </div>

                            <div id="vatInvoiceFieldsBox" class="mt-3 pt-3 border-top @(Model.RequireVatInvoice ? "" : "d-none")">
                                <div class="row g-2">
                                    <div class="col-md-8">
                                        <label class="form-label small fw-semibold">Tên công ty / Đơn vị trên GPKD <span class="text-danger">*</span></label>
                                        <input asp-for="CompanyName" class="form-control form-control-sm" placeholder="VD: CÔNG TY TNHH THƯƠNG MẠI ĐIỆN TỬ..." />
                                        <span asp-validation-for="CompanyName" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-semibold">Mã số thuế (MST) <span class="text-danger">*</span></label>
                                        <input asp-for="CompanyTaxCode" class="form-control form-control-sm font-monospace" placeholder="VD: 0303217354" />
                                        <span asp-validation-for="CompanyTaxCode" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-8">
                                        <label class="form-label small fw-semibold">Địa chỉ trụ sở đăng ký kinh doanh <span class="text-danger">*</span></label>
                                        <input asp-for="CompanyAddress" class="form-control form-control-sm" placeholder="Nhập đầy đủ địa chỉ trên giấy phép kinh doanh..." />
                                        <span asp-validation-for="CompanyAddress" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-semibold">Email nhận hóa đơn điện tử</label>
                                        <input asp-for="CompanyEmail" type="email" class="form-control form-control-sm" placeholder="ketoan@congty.vn" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <h5 class="fw-black border-bottom pb-3 mt-4 mb-3">
                    <i class="bi bi-credit-card-2-front-fill text-primary me-2"></i>2. Chọn phương thức thanh toán
                </h5>

                <div class="d-flex flex-column gap-2">
                    <label class="p-3 border rounded-3 d-flex align-items-start gap-3 payment-method-card @(Model.PaymentMethod == "COD" ? "bg-primary-subtle border-primary" : "bg-white")" style="cursor: pointer;">
                        <input type="radio" asp-for="PaymentMethod" value="COD" class="form-check-input mt-1 payment-method-radio" />
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center justify-content-between">
                                <span class="fw-bold text-dark">Thanh toán tiền mặt khi nhận hàng (COD)</span>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Phổ biến nhất</span>
                            </div>
                            <div class="small text-muted mt-1">Nhân viên kỹ thuật Điện Máy Xanh giao hàng, lắp đặt hoàn chỉnh và kiểm tra vận hành mới thu tiền.</div>
                        </div>
                    </label>

                    @{
                        var defaultCheckoutBank = WebsiteDienMay.Data.BankConfigStore.GetDefault();
                    }
                    <label class="p-3 border rounded-3 d-flex align-items-start gap-3 payment-method-card @(Model.PaymentMethod == "Banking" ? "bg-primary-subtle border-primary" : "bg-white")" style="cursor: pointer;">
                        <input type="radio" asp-for="PaymentMethod" value="Banking" class="form-check-input mt-1 payment-method-radio" />
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center justify-content-between">
                                <span class="fw-bold text-dark">Chuyển khoản ngân hàng / Quét mã VietQR 24/7</span>
                                <span class="badge bg-success-subtle text-success border border-success-subtle">Xác nhận tự động</span>
                            </div>
                            <div class="small text-muted mt-1">
                                Thụ hưởng: <strong class="text-dark">@defaultCheckoutBank.BankName</strong> — STK: <strong class="font-monospace text-primary">@defaultCheckoutBank.AccountNumber</strong> (@defaultCheckoutBank.AccountHolder). Mã QR tự động tạo ngay sau khi đặt hàng.
                            </div>
                        </div>
                    </label>

                    <div class="border rounded-3 overflow-hidden payment-method-card @(Model.PaymentMethod == "Installment" ? "border-primary" : "")">
                        <label class="p-3 d-flex align-items-start gap-3 @(Model.PaymentMethod == "Installment" ? "bg-primary-subtle" : "bg-white")" style="cursor: pointer;">
                            <input type="radio" asp-for="PaymentMethod" value="Installment" class="form-check-input mt-1 payment-method-radio" id="radioInstallment" />
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center justify-content-between">
                                    <span class="fw-bold text-dark">Đăng ký Trả góp 0% lãi suất</span>
                                    <span class="badge bg-warning text-dark">Kỳ hạn 3 - 12 tháng</span>
                                </div>
                                <div class="small text-muted mt-1">Lựa chọn trả góp 0% qua Thẻ tín dụng (25 Ngân hàng) hoặc duyệt hồ sơ Công ty Tài chính bằng CCCD gắn chip.</div>
                            </div>
                        </label>

                        <!-- Khung Cấu Hình Các Phương Thức Trả Góp Chi Tiết -->
                        <div id="installmentConfigBox" class="p-3 bg-light border-top @(Model.PaymentMethod == "Installment" ? "" : "d-none")">
                            <div class="fw-bold text-primary small text-uppercase mb-2">
                                <i class="bi bi-sliders2 me-1"></i>Tùy chọn phương thức & Gói trả góp 0% lãi suất
                            </div>

                            <!-- Bước 2.1: Chọn hình thức trả góp -->
                            <div class="row g-2 mb-3">
                                <div class="col-md-6">
                                    <label class="p-2 px-3 rounded-3 border d-flex align-items-start gap-2 bg-white h-100" style="cursor: pointer;">
                                        <input type="radio" asp-for="InstallmentPartnerType" value="CreditCard" class="form-check-input mt-1 installment-partner-radio" checked />
                                        <div>
                                            <div class="fw-bold small text-dark"><i class="bi bi-credit-card-fill text-primary me-1"></i>Trả góp qua Thẻ tín dụng</div>
                                            <div class="text-muted" style="font-size: 11.5px;">Visa, Mastercard, JCB - Trả trước 0đ, duyệt online 100%</div>
                                        </div>
                                    </label>
                                </div>
                                <div class="col-md-6">
                                    <label class="p-2 px-3 rounded-3 border d-flex align-items-start gap-2 bg-white h-100" style="cursor: pointer;">
                                        <input type="radio" asp-for="InstallmentPartnerType" value="FinanceCompany" class="form-check-input mt-1 installment-partner-radio" />
                                        <div>
                                            <div class="fw-bold small text-dark"><i class="bi bi-person-vcard-fill text-success me-1"></i>Qua Công ty Tài chính</div>
                                            <div class="text-muted" style="font-size: 11.5px;">Duyệt hồ sơ nhanh bằng CCCD gắn chip trong 5 phút</div>
                                        </div>
                                    </label>
                                </div>
                            </div>

                            <!-- Bước 2.2: Chọn Ngân hàng / Đơn vị tài chính, Kỳ hạn, Trả trước -->
                            <div class="row g-2 mb-3">
                                <div class="col-md-5">
                                    <label class="form-label small fw-semibold mb-1" id="providerSelectLabel">Ngân hàng phát hành thẻ:</label>
                                    <select asp-for="InstallmentBankOrProvider" id="installmentProviderSelect" class="form-select form-select-sm fw-semibold">
                                        <option value="Vietcombank">Vietcombank (VCB)</option>
                                        <option value="Techcombank">Techcombank (TCB)</option>
                                        <option value="MBBank">MBBank (Quân Đội)</option>
                                        <option value="VPBank">VPBank</option>
                                        <option value="ACB">Ngân hàng Á Châu (ACB)</option>
                                        <option value="BIDV">BIDV</option>
                                        <option value="VietinBank">VietinBank</option>
                                        <option value="Sacombank">Sacombank</option>
                                        <option value="VIB">Ngân hàng Quốc Tế (VIB)</option>
                                        <option value="TPBank">TPBank</option>
                                        <option value="HSBC">HSBC Việt Nam</option>
                                        <option value="Shinhan Bank">Shinhan Bank</option>
                                    </select>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold mb-1">Kỳ hạn trả góp:</label>
                                    <select asp-for="InstallmentMonths" id="installmentMonthsSelect" class="form-select form-select-sm fw-semibold">
                                        <option value="3">Kỳ hạn 3 tháng (0% lãi)</option>
                                        <option value="6">Kỳ hạn 6 tháng (0% lãi)</option>
                                        <option value="9">Kỳ hạn 9 tháng (0% lãi)</option>
                                        <option value="12">Kỳ hạn 12 tháng (0% lãi)</option>
                                    </select>
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label small fw-semibold mb-1">Mức trả trước:</label>
                                    <select asp-for="InstallmentPrepayPercent" id="installmentPrepaySelect" class="form-select form-select-sm fw-semibold">
                                        <option value="0">0% (Không trả trước)</option>
                                        <option value="20">Trả trước 20%</option>
                                        <option value="30">Trả trước 30%</option>
                                        <option value="40">Trả trước 40%</option>
                                        <option value="50">Trả trước 50%</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Bước 2.3: Bảng Tạm Tính Phương Án Trả Góp Trực Tiếp -->
                            <div class="p-3 rounded-3 bg-white border border-primary-subtle">
                                <div class="d-flex align-items-center justify-content-between border-bottom pb-2 mb-2">
                                    <span class="small fw-bold text-dark"><i class="bi bi-calculator-fill text-primary me-1"></i>Bảng tạm tính gói trả góp của bạn:</span>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Lãi suất 0%</span>
                                </div>
                                <div class="row g-2 text-center small">
                                    <div class="col-4 border-end">
                                        <div class="text-muted">Trả trước (<span id="calcPrepayPctText">0</span>%)</div>
                                        <div id="calcPrepayAmountText" class="fw-bold text-dark fs-6">0 đ</div>
                                    </div>
                                    <div class="col-4 border-end">
                                        <div class="text-muted">Góp mỗi tháng (<span id="calcMonthsText">6</span> tháng)</div>
                                        <div id="calcMonthlyAmountText" class="fw-black text-danger fs-6">0 đ/tháng</div>
                                    </div>
                                    <div class="col-4">
                                        <div class="text-muted">Chênh lệch so với giá mua</div>
                                        <div class="fw-bold text-success fs-6">0 đ</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="dmx-section-card position-sticky" style="top: 120px;">
                <div class="d-flex align-items-center justify-content-between border-bottom pb-3 mb-3">
                    <h5 class="fw-black m-0">Tóm tắt đơn hàng (@totalQty)</h5>
                    <a asp-action="Index" class="small text-primary fw-semibold">Sửa giỏ hàng</a>
                </div>

                <div class="mb-3" style="max-height: 310px; overflow-y: auto;">
                    @foreach (var item in Model.Cart.Items)
                    {
                        <div class="d-flex align-items-center justify-content-between gap-2 border-bottom py-2">
                            <div class="d-flex align-items-center gap-2">
                                <img src="@item.ImageUrl" alt="@item.ProductName" class="border rounded p-1" style="width: 54px; height: 54px; object-fit: contain;" />
                                <div>
                                    <div class="fw-semibold small">@item.ProductName</div>
                                    @if (!string.IsNullOrEmpty(item.SelectedVariant))
                                    {
                                        <div class="badge bg-primary-subtle text-primary border border-primary-subtle my-1" style="font-size: 10.5px;">
                                            Phiên bản: @item.SelectedVariant
                                        </div>
                                    }
                                    <div class="small text-muted">Số lượng: <strong>@item.Quantity</strong> x @item.UnitPrice.ToString("N0") đ</div>
                                </div>
                            </div>
                            <div class="fw-bold text-danger small text-nowrap">@item.Total.ToString("N0") đ</div>
                        </div>
                    }
                </div>

                <!-- Khung áp dụng / đổi Mã giảm giá trực tiếp tại trang Thanh toán -->
                <div class="p-3 rounded-3 bg-light border mb-3">
                    <label class="small fw-bold text-dark mb-2 d-block">
                        <i class="bi bi-ticket-perforated-fill text-primary me-1"></i>Mã giảm giá / Voucher ưu đãi:
                    </label>
                    <div class="input-group input-group-sm mb-2">
                        <input type="text" id="checkoutCouponVisibleInput" value="@Model.Cart.CouponCode" class="form-control fw-bold text-uppercase font-monospace" placeholder="Nhập mã ưu đãi..." />
                        <button type="button" class="btn btn-primary fw-bold px-3" onclick="submitCheckoutCoupon(document.getElementById('checkoutCouponVisibleInput').value)">
                            Áp dụng
                        </button>
                        @if (!string.IsNullOrEmpty(Model.Cart.CouponCode))
                        {
                            <button type="button" class="btn btn-outline-danger fw-bold" onclick="submitCheckoutCoupon('')" title="Gỡ mã giảm giá">
                                Gỡ mã
                            </button>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Cart.CouponCode) && Model.Cart.DiscountAmount > 0)
                    {
                        <div class="small text-success fw-semibold mb-2">
                            <i class="bi bi-check-circle-fill me-1"></i>Đã áp dụng <strong>@Model.Cart.CouponCode</strong>: Giảm <strong>@Model.Cart.DiscountAmount.ToString("N0") đ</strong>
                        </div>
                    }
                    @if (Model.Cart.AvailableCoupons.Any())
                    {
                        <div class="d-flex flex-wrap gap-1 mt-1">
                            @foreach (var cp in Model.Cart.AvailableCoupons)
                            {
                                var isApplied = string.Equals(Model.Cart.CouponCode, cp.Code, StringComparison.OrdinalIgnoreCase);
                                var isEligible = Model.Cart.SubTotal >= cp.MinOrderAmount;
                                var label = cp.DiscountType == "Percentage" ? $"{cp.Code} (-{cp.DiscountValue:0}%)" : $"{cp.Code} (-{cp.DiscountValue / 1000:N0}K)";
                                <button type="button"
                                        class="btn btn-sm py-0 px-2 fw-semibold @(isApplied ? "btn-success" : (isEligible ? "btn-outline-primary bg-white" : "btn-outline-secondary opacity-50"))"
                                        style="font-size: 11px;"
                                        title="@cp.Description (Đơn từ @cp.MinOrderAmount.ToString("N0")đ)"
                                        @(isEligible ? "" : "disabled")
                                        onclick="submitCheckoutCoupon('@cp.Code')">
                                    @label @(isApplied ? "✓" : "")
                                </button>
                            }
                        </div>
                    }
                </div>

                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Tạm tính tiền hàng (chưa VAT):</span>
                    <span class="fw-bold">@Model.Cart.SubTotal.ToString("N0") đ</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Giảm giá Voucher @(string.IsNullOrEmpty(Model.Cart.CouponCode) ? "" : $"({Model.Cart.CouponCode})"):</span>
                    <span class="text-success fw-bold">-@Model.Cart.DiscountAmount.ToString("N0") đ</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Giá trị tính thuế GTGT:</span>
                    <span class="fw-semibold">@Model.Cart.TaxableAmount.ToString("N0") đ</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Thuế GTGT xuất hàng (VAT 8%):</span>
                    <span class="fw-semibold text-primary">+@Model.Cart.VatAmount.ToString("N0") đ</span>
                </div>
                <div class="d-flex justify-content-between mb-3">
                    <span class="text-muted">Vận chuyển & Công lắp đặt:</span>
                    <span class="badge bg-success-subtle text-success border border-success-subtle">Miễn phí</span>
                </div>

                <div class="d-flex justify-content-between align-items-center border-top pt-3 mb-3">
                    <div>
                        <span class="fw-bold fs-6 d-block">Tổng thanh toán:</span>
                        <span class="text-muted" style="font-size: 11px;">(Đã bao gồm thuế GTGT VAT 8%)</span>
                    </div>
                    <span class="fw-black fs-3 text-danger">@Model.Cart.FinalTotal.ToString("N0") đ</span>
                </div>

                <button type="submit" class="dmx-buy-now-btn text-uppercase fs-6">
                    <i class="bi bi-check2-circle me-1"></i>Xác nhận đặt mua ngay
                </button>
            </div>
        </div>
    </div>
</form>

<form asp-action="ApplyCoupon" method="post" id="checkoutCouponForm" class="d-none">
    <input type="hidden" name="returnUrl" value="/Cart/Checkout" />
    <input type="hidden" name="couponCode" id="checkoutCouponHiddenInput" value="" />
</form>
<script>
    function submitCheckoutCoupon(code) {
        var input = document.getElementById("checkoutCouponHiddenInput");
        var form = document.getElementById("checkoutCouponForm");
        if (input && form) {
            input.value = code || "";
            form.submit();
        }
    }
</script>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const API_BASE = "https://provinces.open-api.vn/api/v2";
            const provinceSelect = document.getElementById("provinceSelect");
            const wardSelect = document.getElementById("wardSelect");
            const provinceNameInput = document.getElementById("provinceNameInput");
            const wardNameInput = document.getElementById("wardNameInput");
            const addressDetailInput = document.getElementById("addressDetailInput");
            const shippingAddressHidden = document.getElementById("shippingAddressHidden");
            const fullAddressPreview = document.getElementById("fullAddressPreview");
            const checkoutForm = document.getElementById("checkoutForm");

            const initialProvinceCode = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProvinceCode?.ToString() ?? ""));
            const initialWardCode = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WardCode?.ToString() ?? ""));
            const savedUserAddress = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ShippingAddress ?? ""));

            function normalizeText(str) {
                return (str || "")
                    .toLowerCase()
                    .replace(/^(tỉnh|thành phố|tp\.?|phường|xã|đặc khu)\s+/i, "")
                    .trim();
            }

            function updateFullAddress() {
                const pOption = provinceSelect.options[provinceSelect.selectedIndex];
                const wOption = wardSelect.options[wardSelect.selectedIndex];

                const pName = (provinceSelect.value && pOption) ? pOption.dataset.name || pOption.text : "";
                const wName = (wardSelect.value && wOption) ? wOption.dataset.name || wOption.text : "";
                const detail = (addressDetailInput.value || "").trim();

                provinceNameInput.value = pName;
                wardNameInput.value = wName;

                const parts = [detail, wName, pName].filter(Boolean);
                if (parts.length > 0) {
                    const combined = parts.join(", ");
                    shippingAddressHidden.value = combined;
                    fullAddressPreview.textContent = combined;
                    fullAddressPreview.classList.remove("text-muted");
                    fullAddressPreview.classList.add("text-dark");
                } else {
                    shippingAddressHidden.value = "";
                    fullAddressPreview.textContent = "Vui lòng chọn Tỉnh/Thành phố, Phường/Xã và nhập số nhà, tên đường";
                }
            }

            async function fetchJsonWithFallback(primaryUrl, fallbackUrl) {
                try {
                    const res = await fetch(primaryUrl);
                    if (!res.ok) throw new Error("Primary API error");
                    return await res.json();
                } catch {
                    const fallbackRes = await fetch(fallbackUrl);
                    if (!fallbackRes.ok) throw new Error("Fallback API error");
                    return await fallbackRes.json();
                }
            }

            async function loadWards(provinceCode, autoMatchSaved) {
                wardSelect.innerHTML = '<option value="">-- Đang tải danh sách Phường / Xã... --</option>';
                wardSelect.disabled = true;

                if (!provinceCode) {
                    wardSelect.innerHTML = '<option value="">-- Chọn Tỉnh / Thành phố trước --</option>';
                    updateFullAddress();
                    return;
                }

                try {
                    const data = await fetchJsonWithFallback(
                        `${API_BASE}/p/${provinceCode}?depth=2`,
                        `/Cart/GetNewWards?code=${provinceCode}`
                    );

                    const wards = Array.isArray(data.wards) ? data.wards : [];
                    wardSelect.innerHTML = '<option value="">-- Chọn Phường / Xã / Đặc khu --</option>';

                    let matchedWardValue = "";
                    const lowerSaved = (savedUserAddress || "").toLowerCase();

                    wards.forEach(function (w) {
                        const opt = document.createElement("option");
                        opt.value = w.code;
                        opt.textContent = w.name;
                        opt.dataset.name = w.name;
                        wardSelect.appendChild(opt);

                        if (initialWardCode && String(w.code) === String(initialWardCode)) {
                            matchedWardValue = String(w.code);
                        } else if (autoMatchSaved && !matchedWardValue && lowerSaved) {
                            const cleanWard = normalizeText(w.name);
                            if (cleanWard.length >= 3 && lowerSaved.includes(cleanWard)) {
                                matchedWardValue = String(w.code);
                            }
                        }
                    });

                    wardSelect.disabled = false;
                    if (matchedWardValue) {
                        wardSelect.value = matchedWardValue;
                    }
                    updateFullAddress();
                } catch {
                    wardSelect.innerHTML = '<option value="">-- Không tải được Phường / Xã, vui lòng thử lại --</option>';
                    wardSelect.disabled = false;
                }
            }

            async function loadProvinces() {
                try {
                    const provinces = await fetchJsonWithFallback(
                        `${API_BASE}/p/`,
                        "/Cart/GetNewProvinces"
                    );

                    provinceSelect.innerHTML = '<option value="">-- Chọn Tỉnh / Thành phố --</option>';

                    let matchedProvinceValue = "";
                    const lowerSaved = (savedUserAddress || "").toLowerCase();

                    provinces.forEach(function (p) {
                        const opt = document.createElement("option");
                        opt.value = p.code;
                        opt.textContent = p.name;
                        opt.dataset.name = p.name;
                        provinceSelect.appendChild(opt);

                        if (initialProvinceCode && String(p.code) === String(initialProvinceCode)) {
                            matchedProvinceValue = String(p.code);
                        } else if (!initialProvinceCode && !matchedProvinceValue && lowerSaved) {
                            const cleanProv = normalizeText(p.name);
                            if (cleanProv && lowerSaved.includes(cleanProv)) {
                                matchedProvinceValue = String(p.code);
                            }
                        }
                    });

                    // Tự động điền phần số nhà/đường nếu địa chỉ tài khoản cũ có dấu phẩy
                    if (!addressDetailInput.value && savedUserAddress) {
                        const segments = savedUserAddress.split(",").map(s => s.trim()).filter(Boolean);
                        if (segments.length > 0) {
                            addressDetailInput.value = segments[0];
                        }
                    }

                    if (matchedProvinceValue) {
                        provinceSelect.value = matchedProvinceValue;
                        await loadWards(matchedProvinceValue, !initialWardCode);
                    } else {
                        updateFullAddress();
                    }
                } catch {
                    provinceSelect.innerHTML = '<option value="">-- Lỗi kết nối API Tỉnh / Thành phố --</option>';
                }
            }

            provinceSelect.addEventListener("change", function () {
                loadWards(this.value, false);
            });

            wardSelect.addEventListener("change", updateFullAddress);
            addressDetailInput.addEventListener("input", updateFullAddress);

            checkoutForm.addEventListener("submit", function (e) {
                updateFullAddress();
                if (!provinceSelect.value || !wardSelect.value || !addressDetailInput.value.trim()) {
                    e.preventDefault();
                    if (typeof Swal !== "undefined") {
                        Swal.fire({
                            icon: "warning",
                            title: "Thiếu thông tin địa chỉ nhận hàng",
                            text: "Vui lòng chọn đầy đủ Tỉnh/Thành phố, Phường/Xã và nhập số nhà, tên đường cụ thể.",
                            confirmButtonColor: "#2a83e9",
                            confirmButtonText: "Đã hiểu"
                        });
                    }
                }
            });

            loadProvinces();

            // ================= XỬ LÝ XUẤT HÓA ĐƠN GTGT (VAT) & TÙY CHỌN TRẢ GÓP 0% =================
            const finalOrderTotal = @((long)Math.Round(Model.Cart.FinalTotal, 0));
            const requireVatCheckbox = document.getElementById("requireVatCheckbox");
            const vatInvoiceFieldsBox = document.getElementById("vatInvoiceFieldsBox");

            if (requireVatCheckbox && vatInvoiceFieldsBox) {
                requireVatCheckbox.addEventListener("change", function () {
                    if (this.checked) {
                        vatInvoiceFieldsBox.classList.remove("d-none");
                    } else {
                        vatInvoiceFieldsBox.classList.add("d-none");
                    }
                });
            }

            const paymentRadios = document.querySelectorAll(".payment-method-radio");
            const installmentConfigBox = document.getElementById("installmentConfigBox");
            const partnerRadios = document.querySelectorAll(".installment-partner-radio");
            const providerSelect = document.getElementById("installmentProviderSelect");
            const providerSelectLabel = document.getElementById("providerSelectLabel");
            const monthsSelect = document.getElementById("installmentMonthsSelect");
            const prepaySelect = document.getElementById("installmentPrepaySelect");

            const creditCardBanks = [
                "Vietcombank (VCB)",
                "Techcombank (TCB)",
                "MBBank (Quân Đội)",
                "VPBank",
                "Ngân hàng Á Châu (ACB)",
                "BIDV",
                "VietinBank",
                "Sacombank",
                "Ngân hàng Quốc Tế (VIB)",
                "TPBank",
                "HSBC Việt Nam",
                "Shinhan Bank"
            ];

            const financeCompanies = [
                "Home Credit Việt Nam (Duyệt CCCD 5 phút)",
                "FE Credit (Hỗ trợ toàn quốc)",
                "HD SAISON (Lãi suất ưu đãi 0%)",
                "Mirae Asset Finance",
                "Shinhan Finance"
            ];

            function updateInstallmentCalculator() {
                if (!monthsSelect || !prepaySelect) return;

                let partnerType = "CreditCard";
                partnerRadios.forEach(r => { if (r.checked) partnerType = r.value; });

                if (partnerType === "CreditCard") {
                    prepaySelect.value = "0";
                    prepaySelect.disabled = true;
                } else {
                    prepaySelect.disabled = false;
                    if (prepaySelect.value === "0") {
                        prepaySelect.value = "20";
                    }
                }

                const months = Math.max(1, parseInt(monthsSelect.value || "6", 10));
                const prepayPct = parseInt(prepaySelect.value || "0", 10);
                const prepayAmt = Math.round(finalOrderTotal * prepayPct / 100);
                const remainAmt = Math.max(0, finalOrderTotal - prepayAmt);
                const monthlyAmt = Math.round(remainAmt / months);

                const pctEl = document.getElementById("calcPrepayPctText");
                const prepayEl = document.getElementById("calcPrepayAmountText");
                const monthsEl = document.getElementById("calcMonthsText");
                const monthlyEl = document.getElementById("calcMonthlyAmountText");

                if (pctEl) pctEl.textContent = prepayPct;
                if (prepayEl) prepayEl.textContent = prepayAmt.toLocaleString("vi-VN") + " đ";
                if (monthsEl) monthsEl.textContent = months;
                if (monthlyEl) monthlyEl.textContent = monthlyAmt.toLocaleString("vi-VN") + " đ/tháng";
            }

            function populateProviders(partnerType) {
                if (!providerSelect) return;
                const list = partnerType === "FinanceCompany" ? financeCompanies : creditCardBanks;
                if (providerSelectLabel) {
                    providerSelectLabel.textContent = partnerType === "FinanceCompany"
                        ? "Chọn Công ty tài chính:"
                        : "Ngân hàng phát hành thẻ:";
                }
                providerSelect.innerHTML = "";
                list.forEach(item => {
                    const opt = document.createElement("option");
                    opt.value = item;
                    opt.textContent = item;
                    providerSelect.appendChild(opt);
                });
                updateInstallmentCalculator();
            }

            paymentRadios.forEach(radio => {
                radio.addEventListener("change", function () {
                    if (installmentConfigBox) {
                        if (this.value === "Installment" && this.checked) {
                            installmentConfigBox.classList.remove("d-none");
                            updateInstallmentCalculator();
                        } else {
                            installmentConfigBox.classList.add("d-none");
                        }
                    }
                });
            });

            partnerRadios.forEach(radio => {
                radio.addEventListener("change", function () {
                    if (this.checked) {
                        populateProviders(this.value);
                    }
                });
            });

            if (monthsSelect) monthsSelect.addEventListener("change", updateInstallmentCalculator);
            if (prepaySelect) prepaySelect.addEventListener("change", updateInstallmentCalculator);

            updateInstallmentCalculator();
        });
    </script>
}
